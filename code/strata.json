        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e report = RepairReport::default();",
        "    drop_duplicates(mesh, \u0026amp;\u003cspan class=\"tk\"\u003emut\u003c/span\u003e report);",
        "    split_vertices(mesh, \u0026amp;\u003cspan class=\"tk\"\u003emut\u003c/span\u003e report);",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e parts = orient(mesh, \u0026amp;\u003cspan class=\"tk\"\u003emut\u003c/span\u003e report);",
        "    fill_holes(mesh, \u0026amp;\u003cspan class=\"tk\"\u003emut\u003c/span\u003e report);",
        "    \u003cspan class=\"tc\"\u003e// Holes are filled before judging inside-out: an open part\u0026#39;s volume is\u003c/span\u003e",
        "    \u003cspan class=\"tc\"\u003e// meaningless. Fill triangles belong to the part they close.\u003c/span\u003e",
