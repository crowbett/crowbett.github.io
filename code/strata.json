    {
      "path": "crates/strata-core/src/slice.rs",
      "from": 374,
      "to": 414,
      "title": "Triangle cross-section",
      "why": "Each triangle the plane splits yields one segment keyed by its mesh edges, oriented so the solid stays on its left.",
      "calls": [],
      "text": [
        "pub(crate) fn cross_section(mesh: \u0026Mesh, tri: [u32; 3], z: f64) -\u003e Option\u003cSegment\u003e {",
        "    let pos = tri.map(|v| mesh.vertices[v as usize].map(f64::from));",
        "    let above = pos.map(|p| p[2] \u003e= z);",
        "    let count = above.iter().filter(|\u0026\u0026a| a).count();",
        "    if count == 0 || count == 3 {",
        "        return None;",
        "    }",
        "    // Find the vertex alone on its side of the plane.",
        "    let lone = (0..3)",
        "        .find(|\u0026i| above[i] != above[(i + 1) % 3] \u0026\u0026 above[i] != above[(i + 2) % 3])",
        "        .expect(\"a triangle split 1/2 by the plane has exactly one lone vertex\");",
        "    let next = (lone + 1) % 3;",
        "    let prev = (lone + 2) % 3;",
        "",
        "    let point_on = |a: usize, b: usize| {",
        "        let (pa, pb) = (pos[a], pos[b]);",
        "        let t = (z - pa[2]) / (pb[2] - pa[2]);",
        "        Point2::new(pa[0] + t * (pb[0] - pa[0]), pa[1] + t * (pb[1] - pa[1]))",
        "    };",
        "    let out_edge = edge_key(tri[lone], tri[next]);",
        "    let in_edge = edge_key(tri[prev], tri[lone]);",
        "",
        "    // With outward-facing CCW winding, a lone vertex above the plane yields",
        "    // a segment from its outgoing edge to its incoming edge that keeps the",
        "    // solid on the left. A lone vertex below mirrors this.",
        "    Some(if above[lone] {",
        "        Segment {",
        "            from: out_edge,",
        "            to: in_edge,",
        "            start: point_on(lone, next),",
        "            end: point_on(prev, lone),",
        "        }",
        "    } else {",
        "        Segment {",
        "            from: in_edge,",
        "            to: out_edge,",
        "            start: point_on(prev, lone),",
        "            end: point_on(lone, next),",
        "        }",
        "    })",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tk\"\u003epub\u003c/span\u003e(\u003cspan class=\"tk\"\u003ecrate\u003c/span\u003e) \u003cspan class=\"tk\"\u003efn\u003c/span\u003e \u003cspan class=\"tf\"\u003ecross_section\u003c/span\u003e(mesh: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"tt\"\u003eMesh\u003c/span\u003e, tri: [\u003cspan class=\"tt\"\u003eu32\u003c/span\u003e; \u003cspan class=\"tn\"\u003e3\u003c/span\u003e], z: \u003cspan class=\"tt\"\u003ef64\u003c/span\u003e) -\u0026gt; \u003cspan class=\"tt\"\u003eOption\u003c/span\u003e\u0026lt;Segment\u0026gt; {",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e pos = tri.map(|v| mesh.vertices[v \u003cspan class=\"tk\"\u003eas\u003c/span\u003e \u003cspan class=\"tt\"\u003eusize\u003c/span\u003e].map(\u003cspan class=\"tt\"\u003ef64\u003c/span\u003e::from));",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e above = pos.map(|p| p[\u003cspan class=\"tn\"\u003e2\u003c/span\u003e] \u0026gt;= z);",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e count = above.iter().filter(|\u0026amp;\u0026amp;a| a).count();",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e count == \u003cspan class=\"tn\"\u003e0\u003c/span\u003e || count == \u003cspan class=\"tn\"\u003e3\u003c/span\u003e {",
        "        \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tt\"\u003eNone\u003c/span\u003e;",
        "    }",
        "    \u003cspan class=\"tc\"\u003e// Find the vertex alone on its side of the plane.\u003c/span\u003e",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e lone = (\u003cspan class=\"tn\"\u003e0\u003c/span\u003e..\u003cspan class=\"tn\"\u003e3\u003c/span\u003e)",
        "        .find(|\u0026amp;i| above[i] != above[(i + \u003cspan class=\"tn\"\u003e1\u003c/span\u003e) % \u003cspan class=\"tn\"\u003e3\u003c/span\u003e] \u0026amp;\u0026amp; above[i] != above[(i + \u003cspan class=\"tn\"\u003e2\u003c/span\u003e) % \u003cspan class=\"tn\"\u003e3\u003c/span\u003e])",
        "        .expect(\u003cspan class=\"ts\"\u003e\u0026#34;a triangle split 1/2 by the plane has exactly one lone vertex\u0026#34;\u003c/span\u003e);",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e next = (lone + \u003cspan class=\"tn\"\u003e1\u003c/span\u003e) % \u003cspan class=\"tn\"\u003e3\u003c/span\u003e;",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e prev = (lone + \u003cspan class=\"tn\"\u003e2\u003c/span\u003e) % \u003cspan class=\"tn\"\u003e3\u003c/span\u003e;",
        "",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e point_on = |a: \u003cspan class=\"tt\"\u003eusize\u003c/span\u003e, b: \u003cspan class=\"tt\"\u003eusize\u003c/span\u003e| {",
        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e (pa, pb) = (pos[a], pos[b]);",
        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e t = (z - pa[\u003cspan class=\"tn\"\u003e2\u003c/span\u003e]) / (pb[\u003cspan class=\"tn\"\u003e2\u003c/span\u003e] - pa[\u003cspan class=\"tn\"\u003e2\u003c/span\u003e]);",
        "        Point2::new(pa[\u003cspan class=\"tn\"\u003e0\u003c/span\u003e] + t * (pb[\u003cspan class=\"tn\"\u003e0\u003c/span\u003e] - pa[\u003cspan class=\"tn\"\u003e0\u003c/span\u003e]), pa[\u003cspan class=\"tn\"\u003e1\u003c/span\u003e] + t * (pb[\u003cspan class=\"tn\"\u003e1\u003c/span\u003e] - pa[\u003cspan class=\"tn\"\u003e1\u003c/span\u003e]))",
        "    };",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e out_edge = edge_key(tri[lone], tri[next]);",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e in_edge = edge_key(tri[prev], tri[lone]);",
        "",
        "    \u003cspan class=\"tc\"\u003e// With outward-facing CCW winding, a lone vertex above the plane yields\u003c/span\u003e",
        "    \u003cspan class=\"tc\"\u003e// a segment from its outgoing edge to its incoming edge that keeps the\u003c/span\u003e",
        "    \u003cspan class=\"tc\"\u003e// solid on the left. A lone vertex below mirrors this.\u003c/span\u003e",
        "    \u003cspan class=\"tt\"\u003eSome\u003c/span\u003e(\u003cspan class=\"tk\"\u003eif\u003c/span\u003e above[lone] {",
        "        Segment {",
        "            from: \u003cspan class=\"tt\"\u003eout_edge\u003c/span\u003e,",
        "            to: \u003cspan class=\"tt\"\u003ein_edge\u003c/span\u003e,",
        "            start: \u003cspan class=\"tt\"\u003epoint_on\u003c/span\u003e(lone, next),",
        "            end: \u003cspan class=\"tt\"\u003epoint_on\u003c/span\u003e(prev, lone),",
        "        }",
        "    } \u003cspan class=\"tk\"\u003eelse\u003c/span\u003e {",
        "        Segment {",
        "            from: \u003cspan class=\"tt\"\u003ein_edge\u003c/span\u003e,",
        "            to: \u003cspan class=\"tt\"\u003eout_edge\u003c/span\u003e,",
        "            start: \u003cspan class=\"tt\"\u003epoint_on\u003c/span\u003e(prev, lone),",
        "            end: \u003cspan class=\"tt\"\u003epoint_on\u003c/span\u003e(lone, next),",
        "        }",
        "    })",
        "}"
      ]
    }
  ],
