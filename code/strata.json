      "from": 51,
      "to": 63,
      "title": "Mesh repair pipeline",
      "why": "Repairs topology in a fixed order and fills holes before judging which parts are inside out, as an open part has no volume.",
      "calls": [
        "load model=xy",
        "load model=tower",
        "load model=retraction"
      ],
      "text": [
        "/// Repairs `mesh` in place.",
        "pub fn repair(mesh: \u0026mut Mesh) -\u003e RepairReport {",
        "    let mut report = RepairReport::default();",
        "    drop_duplicates(mesh, \u0026mut report);",
        "    split_vertices(mesh, \u0026mut report);",
        "    let parts = orient(mesh, \u0026mut report);",
        "    fill_holes(mesh, \u0026mut report);",
        "    // Holes are filled before judging inside-out: an open part's volume is",
        "    // meaningless. Fill triangles belong to the part they close.",
        "    fix_inverted_parts(mesh, \u0026parts, \u0026mut report);",
        "    report.open_edges_remaining = mesh.open_edge_count();",
        "    report",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"ts\"\u003e/// Repairs `mesh` in place.\u003c/span\u003e",
