    {
      "path": "internal/index/search.go",
      "from": 176,
      "to": 187,
      "title": "Stage 2: verify candidates",
      "why": "The real matcher runs over the candidates in rank order, and refuses a candidate set made before an index reload.",
      "calls": [
        "match"
      ],
      "text": [
        "// Match runs stage 2 on cs: the real matcher over every candidate from one",
        "// global work queue in rank order, stopping early once enough lines are",
        "// found. It fails with ErrStale if the index was reloaded after cs was made.",
        "// Stats.Millis is left zero; Search times both stages.",
        "func (ix *Index) Match(ctx context.Context, cs *Candidates) (*Result, error) {",
        "\tix.mu.RLock()",
        "\tdefer ix.mu.RUnlock()",
        "\tif cs.gen != ix.gen {",
        "\t\treturn nil, ErrStale",
        "\t}",
        "\treturn cs.verify(ctx)",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// Match runs stage 2 on cs: the real matcher over every candidate from one\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// global work queue in rank order, stopping early once enough lines are\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// found. It fails with ErrStale if the index was reloaded after cs was made.\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// Stats.Millis is left zero; Search times both stages.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (ix *Index) \u003cspan class=\"tf\"\u003eMatch\u003c/span\u003e(ctx context.Context, cs *Candidates) (*Result, \u003cspan class=\"tt\"\u003eerror\u003c/span\u003e) {",
        "\tix.mu.\u003cspan class=\"tf\"\u003eRLock\u003c/span\u003e()",
        "\t\u003cspan class=\"tk\"\u003edefer\u003c/span\u003e ix.mu.\u003cspan class=\"tf\"\u003eRUnlock\u003c/span\u003e()",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e cs.gen != ix.gen {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tk\"\u003enil\u003c/span\u003e, ErrStale",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e cs.\u003cspan class=\"tf\"\u003everify\u003c/span\u003e(ctx)",
        "}"
      ]
