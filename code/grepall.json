    {
      "path": "internal/index/search.go",
      "from": 168,
      "to": 174,
      "title": "Stage 1: candidates per shard",
      "why": "The trigram query and filters run per shard in parallel, under the index read lock.",
      "calls": [
        "candidates"
      ],
      "text": [
        "// Candidates runs stage 1 alone: per shard in parallel, the trigram query and",
        "// the filters. Match finishes the search.",
        "func (ix *Index) Candidates(ctx context.Context, c *query.Compiled, opts SearchOptions) (*Candidates, error) {",
        "\tix.mu.RLock()",
        "\tdefer ix.mu.RUnlock()",
        "\treturn ix.candidates(ctx, c, opts)",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// Candidates runs stage 1 alone: per shard in parallel, the trigram query and\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// the filters. Match finishes the search.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (ix *Index) \u003cspan class=\"tf\"\u003eCandidates\u003c/span\u003e(ctx context.Context, c *query.Compiled, opts SearchOptions) (*Candidates, \u003cspan class=\"tt\"\u003eerror\u003c/span\u003e) {",
        "\tix.mu.\u003cspan class=\"tf\"\u003eRLock\u003c/span\u003e()",
        "\t\u003cspan class=\"tk\"\u003edefer\u003c/span\u003e ix.mu.\u003cspan class=\"tf\"\u003eRUnlock\u003c/span\u003e()",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e ix.\u003cspan class=\"tf\"\u003ecandidates\u003c/span\u003e(ctx, c, opts)",
        "}"
      ]
