      "path": "internal/query/plan.go",
      "from": 199,
      "to": 235,
      "title": "Joining two regexp pieces",
      "why": "Concatenation adds the strings that span the boundary, and keeps exact sets only while their cross product stays small.",
      "calls": [],
      "text": [
        "func concat(x, y info) info {",
        "\tif x.exactOK \u0026\u0026 y.exactOK \u0026\u0026 len(x.exact)*len(y.exact) \u003c= maxExact {",
        "\t\treturn simplify(info{",
        "\t\t\tcanEmpty: x.canEmpty \u0026\u0026 y.canEmpty,",
        "\t\t\texactOK:  true,",
        "\t\t\texact:    x.exact.cross(y.exact),",
        "\t\t\tmatch:    and(x.match, y.match),",
        "\t\t})",
        "\t}",
        "\txs, yp := x.suffixOrExact(), y.prefixOrExact()",
        "\tr := info{",
        "\t\tcanEmpty: x.canEmpty \u0026\u0026 y.canEmpty,",
        "\t\tmatch:    and(x.fullMatch(), y.fullMatch()),",
        "\t}",
        "\t// Strings spanning the boundary: some suffix of x followed by some",
        "\t// prefix of y must occur in the document.",
        "\tif len(xs)*len(yp) \u003c= maxSet {",
        "\t\tr.match = and(r.match, xs.cross(yp).orQuery())",
        "\t}",
        "\tswitch {",
        "\tcase !x.exactOK:",
        "\t\tr.prefix = x.prefix",
        "\tcase len(x.exact)*len(yp) \u003c= maxSet:",
        "\t\tr.prefix = x.exact.cross(yp)",
        "\tdefault:",
        "\t\tr.prefix = x.exact",
        "\t}",
        "\tswitch {",
        "\tcase !y.exactOK:",
        "\t\tr.suffix = y.suffix",
        "\tcase len(xs)*len(y.exact) \u003c= maxSet:",
        "\t\tr.suffix = xs.cross(y.exact)",
        "\tdefault:",
        "\t\tr.suffix = y.exact",
        "\t}",
        "\treturn simplify(r)",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e \u003cspan class=\"tf\"\u003econcat\u003c/span\u003e(x, y info) info {",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e x.exactOK \u0026amp;\u0026amp; y.exactOK \u0026amp;\u0026amp; \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(x.exact)*\u003cspan class=\"tt\"\u003elen\u003c/span\u003e(y.exact) \u0026lt;= maxExact {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tf\"\u003esimplify\u003c/span\u003e(info{",
        "\t\t\tcanEmpty: x.canEmpty \u0026amp;\u0026amp; y.canEmpty,",
        "\t\t\texactOK:  \u003cspan class=\"tk\"\u003etrue\u003c/span\u003e,",
        "\t\t\texact:    x.exact.\u003cspan class=\"tf\"\u003ecross\u003c/span\u003e(y.exact),",
        "\t\t\tmatch:    \u003cspan class=\"tf\"\u003eand\u003c/span\u003e(x.match, y.match),",
        "\t\t})",
        "\t}",
        "\txs, yp := x.\u003cspan class=\"tf\"\u003esuffixOrExact\u003c/span\u003e(), y.\u003cspan class=\"tf\"\u003eprefixOrExact\u003c/span\u003e()",
        "\tr := info{",
        "\t\tcanEmpty: x.canEmpty \u0026amp;\u0026amp; y.canEmpty,",
        "\t\tmatch:    \u003cspan class=\"tf\"\u003eand\u003c/span\u003e(x.\u003cspan class=\"tf\"\u003efullMatch\u003c/span\u003e(), y.\u003cspan class=\"tf\"\u003efullMatch\u003c/span\u003e()),",
        "\t}",
        "\t\u003cspan class=\"tc\"\u003e// Strings spanning the boundary: some suffix of x followed by some\u003c/span\u003e",
        "\t\u003cspan class=\"tc\"\u003e// prefix of y must occur in the document.\u003c/span\u003e",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(xs)*\u003cspan class=\"tt\"\u003elen\u003c/span\u003e(yp) \u0026lt;= maxSet {",
        "\t\tr.match = \u003cspan class=\"tf\"\u003eand\u003c/span\u003e(r.match, xs.\u003cspan class=\"tf\"\u003ecross\u003c/span\u003e(yp).\u003cspan class=\"tf\"\u003eorQuery\u003c/span\u003e())",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003eswitch\u003c/span\u003e {",
        "\t\u003cspan class=\"tk\"\u003ecase\u003c/span\u003e !x.exactOK:",
        "\t\tr.prefix = x.prefix",
        "\t\u003cspan class=\"tk\"\u003ecase\u003c/span\u003e \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(x.exact)*\u003cspan class=\"tt\"\u003elen\u003c/span\u003e(yp) \u0026lt;= maxSet:",
        "\t\tr.prefix = x.exact.\u003cspan class=\"tf\"\u003ecross\u003c/span\u003e(yp)",
        "\t\u003cspan class=\"tk\"\u003edefault\u003c/span\u003e:",
        "\t\tr.prefix = x.exact",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003eswitch\u003c/span\u003e {",
        "\t\u003cspan class=\"tk\"\u003ecase\u003c/span\u003e !y.exactOK:",
        "\t\tr.suffix = y.suffix",
        "\t\u003cspan class=\"tk\"\u003ecase\u003c/span\u003e \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(xs)*\u003cspan class=\"tt\"\u003elen\u003c/span\u003e(y.exact) \u0026lt;= maxSet:",
        "\t\tr.suffix = xs.\u003cspan class=\"tf\"\u003ecross\u003c/span\u003e(y.exact)",
        "\t\u003cspan class=\"tk\"\u003edefault\u003c/span\u003e:",
        "\t\tr.suffix = y.exact",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tf\"\u003esimplify\u003c/span\u003e(r)",
        "}"
      ]
