        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e files = find_files(store, path, filter)?;",
        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e out = \u003cspan class=\"tt\"\u003eVec\u003c/span\u003e::new();",
        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e st = conn.prepare_cached(\u0026amp;\u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(",
        "            \u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e\u003cspan class=\"ts\"\u003e{SYM_SELECT}\u003c/span\u003e\u003cspan class=\"ts\"\u003e WHERE s.file_id = ?1 AND s.start_line \u0026lt;= ?2 AND s.end_line \u0026gt;= ?2\u003c/span\u003e",
        "\u003cspan class=\"ts\"\u003e             ORDER BY (s.end_line - s.start_line) ASC LIMIT 1\u0026#34;\u003c/span\u003e",
        "        ))?;",
        "        \u003cspan class=\"tk\"\u003efor\u003c/span\u003e (fid, ..) \u003cspan class=\"tk\"\u003ein\u003c/span\u003e files {",
        "            \u003cspan class=\"tk\"\u003eif\u003c/span\u003e \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tt\"\u003eSome\u003c/span\u003e(s) = st",
        "                .query_row(rusqlite::\u003cspan class=\"tf\"\u003eparams!\u003c/span\u003e[fid, line], sym_from_row)",
        "                .optional()?",
        "            {",
        "                out.push(s);",
        "            }",
        "        }",
        "        \u003cspan class=\"tk\"\u003eif\u003c/span\u003e out.is_empty() {",
        "            \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tt\"\u003eErr\u003c/span\u003e(Error::NotFound(\u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;no symbol encloses \u003c/span\u003e\u003cspan class=\"ts\"\u003e{spec}\u003c/span\u003e\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e)));",
        "        }",
        "        \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tt\"\u003eOk\u003c/span\u003e(out);",
        "    }",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e key = qkey(spec);",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e f = filter.sql();",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e tiers = [",
        "        \u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e\u003cspan class=\"ts\"\u003e{SYM_SELECT}\u003c/span\u003e\u003cspan class=\"ts\"\u003e WHERE s.qkey = ?1 \u003c/span\u003e\u003cspan class=\"ts\"\u003e{f}\u003c/span\u003e\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e),",
        "        \u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(",
        "            \u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e\u003cspan class=\"ts\"\u003e{SYM_SELECT}\u003c/span\u003e\u003cspan class=\"ts\"\u003e WHERE length(s.qkey) \u0026gt; length(?1) AND substr(s.qkey, -length(?1) - 1) = \u0026#39;.\u0026#39; || ?1 \u003c/span\u003e\u003cspan class=\"ts\"\u003e{f}\u003c/span\u003e\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e",
        "        ),",
        "        \u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e\u003cspan class=\"ts\"\u003e{SYM_SELECT}\u003c/span\u003e\u003cspan class=\"ts\"\u003e WHERE s.name = ?1 \u003c/span\u003e\u003cspan class=\"ts\"\u003e{f}\u003c/span\u003e\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e),",
        "        \u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e\u003cspan class=\"ts\"\u003e{SYM_SELECT}\u003c/span\u003e\u003cspan class=\"ts\"\u003e WHERE s.name = ?1 COLLATE NOCASE \u003c/span\u003e\u003cspan class=\"ts\"\u003e{f}\u003c/span\u003e\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e),",
