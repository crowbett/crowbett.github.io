        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e rows = st.query_map([arg], sym_from_row)?;",
        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e v = rows.collect::\u0026lt;rusqlite::\u003cspan class=\"tt\"\u003eResult\u003c/span\u003e\u0026lt;\u003cspan class=\"tt\"\u003eVec\u003c/span\u003e\u0026lt;_\u0026gt;\u0026gt;\u0026gt;()?;",
