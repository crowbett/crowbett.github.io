      "title": "Resolve a symbol spec",
      "why": "Takes file:line, a qualified name or a bare name, trying exact, suffix, name and case-blind matches in turn.",
      "calls": [
        "callers",
        "callees"
      ],
      "text": [
        "/// Resolve a symbol spec: `file:line`, qualified name (`pkg.Type.Method`,",
        "/// `mod::Type::method`), or simple name. Returns the best tier of matches.",
        "pub fn resolve_target(store: \u0026Store, spec: \u0026str, filter: \u0026Filter) -\u003e Result\u003cVec\u003cSym\u003e\u003e {",
        "    let conn = store.conn();",
        "    let spec = spec.trim();",
        "    if spec.is_empty() {",
        "        return Err(Error::Usage(\"empty symbol\".into()));",
        "    }",
        "    if let Some((path, line)) = split_file_line(spec) {",
        "        let files = find_files(store, path, filter)?;",
        "        let mut out = Vec::new();",
        "        let mut st = conn.prepare_cached(\u0026format!(",
        "            \"{SYM_SELECT} WHERE s.file_id = ?1 AND s.start_line \u003c= ?2 AND s.end_line \u003e= ?2",
        "             ORDER BY (s.end_line - s.start_line) ASC LIMIT 1\"",
        "        ))?;",
        "        for (fid, ..) in files {",
        "            if let Some(s) = st",
        "                .query_row(rusqlite::params![fid, line], sym_from_row)",
        "                .optional()?",
        "            {",
        "                out.push(s);",
        "            }",
        "        }",
        "        if out.is_empty() {",
        "            return Err(Error::NotFound(format!(\"no symbol encloses {spec}\")));",
        "        }",
        "        return Ok(out);",
        "    }",
        "    let key = qkey(spec);",
        "    let f = filter.sql();",
        "    let tiers = [",
        "        format!(\"{SYM_SELECT} WHERE s.qkey = ?1 {f}\"),",
        "        format!(",
        "            \"{SYM_SELECT} WHERE length(s.qkey) \u003e length(?1) AND substr(s.qkey, -length(?1) - 1) = '.' || ?1 {f}\"",
        "        ),",
        "        format!(\"{SYM_SELECT} WHERE s.name = ?1 {f}\"),",
        "        format!(\"{SYM_SELECT} WHERE s.name = ?1 COLLATE NOCASE {f}\"),",
        "    ];",
        "    for (i, sql) in tiers.iter().enumerate() {",
        "        let arg = if i \u003e= 2 {",
        "            spec.to_string()",
        "        } else {",
        "            key.clone()",
        "        };",
        "        let mut st =",
        "            conn.prepare_cached(\u0026format!(\"{sql} ORDER BY s.kind, r.name, f.path LIMIT 50\"))?;",
        "        let rows = st.query_map([arg], sym_from_row)?;",
        "        let v = rows.collect::\u003crusqlite::Result\u003cVec\u003c_\u003e\u003e\u003e()?;",
        "        if !v.is_empty() {",
        "            return Ok(rank_targets(v));",
        "        }",
        "    }",
        "    Err(Error::NotFound(format!(",
        "        \"no symbol named `{spec}` (try `codegraph find {spec}`)\"",
        "    )))",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"ts\"\u003e/// Resolve a symbol spec: `file:line`, qualified name (`pkg.Type.Method`,\u003c/span\u003e",
        "\u003cspan class=\"ts\"\u003e/// `mod::Type::method`), or simple name. Returns the best tier of matches.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003epub\u003c/span\u003e \u003cspan class=\"tk\"\u003efn\u003c/span\u003e \u003cspan class=\"tf\"\u003eresolve_target\u003c/span\u003e(store: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"tt\"\u003eStore\u003c/span\u003e, spec: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"tt\"\u003estr\u003c/span\u003e, filter: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"tt\"\u003eFilter\u003c/span\u003e) -\u0026gt; \u003cspan class=\"tt\"\u003eResult\u003c/span\u003e\u0026lt;\u003cspan class=\"tt\"\u003eVec\u003c/span\u003e\u0026lt;Sym\u0026gt;\u0026gt; {",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e conn = store.conn();",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e spec = spec.trim();",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e spec.is_empty() {",
