      "path": "src/integrator.h",
      "from": 88,
      "to": 153,
      "title": "NEE with MIS and Russian roulette",
      "why": "Each bounce casts a shadow ray at a light and weighs it against the bounce by the power heuristic, so no light is counted twice.",
      "calls": [
        "render sampling=nee"
      ],
      "text": [
        "// NEE + MIS. Emission at hit k (k \u003c= depth) is found either by the shadow ray cast from hit",
        "// k-1 or by the path's own bounce; each is weighted by its share of the power heuristic over",
        "// the two densities of that direction. Both densities are functions of direction alone (what",
        "// lies along it, emitter or not, is whatever the ray hits first), so the weights sum to one",
        "// even for emitters missing from `lights`, and for lights that are not emitters. Paths end by",
        "// Russian roulette as well as at `depth`.",
        "inline Color ray_color_nee(const Ray\u0026 r, int depth, const Hittable\u0026 world, Rng\u0026 rng,",
        "                           const std::optional\u003cColor\u003e\u0026 background, const Hittable* lights) {",
        "  Color radiance{};",
        "  Color throughput{1, 1, 1};",
        "  Ray ray = r;",
        "  bool weigh_emission = false;  // the last bounce was non-specular and the lights were sampled",
        "  double bounce_pdf = 0;        // material density of that bounce's direction",
        "  Point3 bounce_origin;",
        "  for (int hit = 1; hit \u003c= depth; ++hit) {",
        "    HitRecord rec;",
        "    if (!world.hit(ray, Interval{kShadowEpsilon, kInfinity}, rec)) {",
        "      radiance += throughput * (background ? *background : sky(ray));  // never light-sampled",
        "      break;",
        "    }",
        "    if (const Color emitted = rec.mat-\u003eemitted(ray, rec); !(emitted == Color{})) {",
        "      const double weight =",
        "          weigh_emission ? power_heuristic(bounce_pdf, lights-\u003epdf_value(bounce_origin, ray.direction)) : 1.0;",
        "      radiance += throughput * emitted * weight;",
        "    }",
        "    ScatterRecord srec;",
        "    if (!rec.mat-\u003escatter(ray, rec, rng, srec)) break;",
        "    if (!srec.pdf) {",
        "      throughput = throughput * srec.attenuation;",
        "      ray = srec.specular_ray;",
        "      weigh_emission = false;  // a delta bounce can't be matched by a light sample",
        "      continue;",
        "    }",
        "",
        "    if (lights != nullptr \u0026\u0026 hit \u003c depth) {  // the shadow ray finds emission at hit + 1",
        "      const Vec3 to_light = lights-\u003erandom(rec.p, rng);",
        "      const double light_pdf = lights-\u003epdf_value(rec.p, to_light);",
        "      const Ray shadow{rec.p, to_light, ray.time};",
        "      const double scattering_pdf = rec.mat-\u003escattering_pdf(ray, rec, shadow);",
        "      HitRecord lrec;",
        "      if (light_pdf \u003e 0 \u0026\u0026 scattering_pdf \u003e 0 \u0026\u0026 world.hit(shadow, Interval{kShadowEpsilon, kInfinity}, lrec)) {",
        "        const Color emitted = lrec.mat-\u003eemitted(shadow, lrec);",
        "        const double weight = power_heuristic(light_pdf, srec.pdf-\u003evalue(to_light));",
        "        radiance += throughput * srec.attenuation * emitted * (scattering_pdf * weight / light_pdf);",
        "      }",
        "    }",
        "",
        "    const Vec3 direction = srec.pdf-\u003egenerate(rng);",
        "    const double pdf_value = srec.pdf-\u003evalue(direction);",
        "    const Ray scattered{rec.p, direction, ray.time};",
        "    const double scattering_pdf = rec.mat-\u003escattering_pdf(ray, rec, scattered);",
        "    if (!(pdf_value \u003e 0) || scattering_pdf \u003c= 0) break;",
        "    throughput = throughput * srec.attenuation * (scattering_pdf / pdf_value);",
        "    weigh_emission = lights != nullptr;",
        "    bounce_pdf = pdf_value;",
        "    bounce_origin = rec.p;",
        "    ray = scattered;",
        "",
        "    if (hit \u003e= kRouletteStart) {",
        "      const double survive = std::min(0.95, std::max({throughput.x, throughput.y, throughput.z}));",
        "      if (rng.uniform() \u003e= survive) break;",
        "      throughput = throughput / survive;",
        "    }",
        "  }",
        "  return radiance;",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// NEE + MIS. Emission at hit k (k \u0026lt;= depth) is found either by the shadow ray cast from hit\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// k-1 or by the path\u0026#39;s own bounce; each is weighted by its share of the power heuristic over\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// the two densities of that direction. Both densities are functions of direction alone (what\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// lies along it, emitter or not, is whatever the ray hits first), so the weights sum to one\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// even for emitters missing from `lights`, and for lights that are not emitters. Paths end by\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// Russian roulette as well as at `depth`.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003einline\u003c/span\u003e Color \u003cspan class=\"tf\"\u003eray_color_nee\u003c/span\u003e(\u003cspan class=\"tk\"\u003econst\u003c/span\u003e Ray\u0026amp; r, \u003cspan class=\"tt\"\u003eint\u003c/span\u003e depth, \u003cspan class=\"tk\"\u003econst\u003c/span\u003e Hittable\u0026amp; world, Rng\u0026amp; rng,",
        "                           \u003cspan class=\"tk\"\u003econst\u003c/span\u003e std::optional\u0026lt;Color\u0026gt;\u0026amp; background, \u003cspan class=\"tk\"\u003econst\u003c/span\u003e Hittable* lights) {",
        "  Color radiance{};",
        "  Color throughput{\u003cspan class=\"tn\"\u003e1\u003c/span\u003e, \u003cspan class=\"tn\"\u003e1\u003c/span\u003e, \u003cspan class=\"tn\"\u003e1\u003c/span\u003e};",
        "  Ray ray = r;",
        "  \u003cspan class=\"tt\"\u003ebool\u003c/span\u003e weigh_emission = \u003cspan class=\"tt\"\u003efalse\u003c/span\u003e;  \u003cspan class=\"tc\"\u003e// the last bounce was non-specular and the lights were sampled\u003c/span\u003e",
        "  \u003cspan class=\"tt\"\u003edouble\u003c/span\u003e bounce_pdf = \u003cspan class=\"tn\"\u003e0\u003c/span\u003e;        \u003cspan class=\"tc\"\u003e// material density of that bounce\u0026#39;s direction\u003c/span\u003e",
        "  Point3 bounce_origin;",
        "  \u003cspan class=\"tk\"\u003efor\u003c/span\u003e (\u003cspan class=\"tt\"\u003eint\u003c/span\u003e hit = \u003cspan class=\"tn\"\u003e1\u003c/span\u003e; hit \u0026lt;= depth; ++hit) {",
        "    HitRecord rec;",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e (!world.\u003cspan class=\"tf\"\u003ehit\u003c/span\u003e(ray, Interval{kShadowEpsilon, kInfinity}, rec)) {",
        "      radiance += throughput * (background ? *\u003cspan class=\"ta\"\u003ebackground\u003c/span\u003e : \u003cspan class=\"tf\"\u003esky\u003c/span\u003e(ray));  \u003cspan class=\"tc\"\u003e// never light-sampled\u003c/span\u003e",
        "      \u003cspan class=\"tk\"\u003ebreak\u003c/span\u003e;",
        "    }",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e (\u003cspan class=\"tk\"\u003econst\u003c/span\u003e Color emitted = rec.mat-\u0026gt;\u003cspan class=\"tf\"\u003eemitted\u003c/span\u003e(ray, rec); !(emitted == Color{})) {",
        "      \u003cspan class=\"tk\"\u003econst\u003c/span\u003e \u003cspan class=\"tt\"\u003edouble\u003c/span\u003e weight =",
        "          weigh_emission ? \u003cspan class=\"tf\"\u003epower_heuristic\u003c/span\u003e(bounce_pdf, lights-\u0026gt;\u003cspan class=\"tf\"\u003epdf_value\u003c/span\u003e(bounce_origin, ray.direction)) : \u003cspan class=\"tn\"\u003e1.0\u003c/span\u003e;",
        "      radiance += throughput * emitted * weight;",
        "    }",
        "    ScatterRecord srec;",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e (!rec.mat-\u0026gt;\u003cspan class=\"tf\"\u003escatter\u003c/span\u003e(ray, rec, rng, srec)) \u003cspan class=\"tk\"\u003ebreak\u003c/span\u003e;",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e (!srec.pdf) {",
        "      throughput = throughput * srec.attenuation;",
        "      ray = srec.specular_ray;",
        "      weigh_emission = \u003cspan class=\"tt\"\u003efalse\u003c/span\u003e;  \u003cspan class=\"tc\"\u003e// a delta bounce can\u0026#39;t be matched by a light sample\u003c/span\u003e",
        "      \u003cspan class=\"tk\"\u003econtinue\u003c/span\u003e;",
        "    }",
        "",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e (lights != nullptr \u0026amp;\u0026amp; hit \u0026lt; depth) {  \u003cspan class=\"tc\"\u003e// the shadow ray finds emission at hit + 1\u003c/span\u003e",
        "      \u003cspan class=\"tk\"\u003econst\u003c/span\u003e Vec3 to_light = lights-\u0026gt;\u003cspan class=\"tf\"\u003erandom\u003c/span\u003e(rec.p, rng);",
        "      \u003cspan class=\"tk\"\u003econst\u003c/span\u003e \u003cspan class=\"tt\"\u003edouble\u003c/span\u003e light_pdf = lights-\u0026gt;\u003cspan class=\"tf\"\u003epdf_value\u003c/span\u003e(rec.p, to_light);",
        "      \u003cspan class=\"tk\"\u003econst\u003c/span\u003e Ray shadow{rec.p, to_light, ray.time};",
        "      \u003cspan class=\"tk\"\u003econst\u003c/span\u003e \u003cspan class=\"tt\"\u003edouble\u003c/span\u003e scattering_pdf = rec.mat-\u0026gt;\u003cspan class=\"tf\"\u003escattering_pdf\u003c/span\u003e(ray, rec, shadow);",
        "      HitRecord lrec;",
        "      \u003cspan class=\"tk\"\u003eif\u003c/span\u003e (light_pdf \u0026gt; \u003cspan class=\"tn\"\u003e0\u003c/span\u003e \u0026amp;\u0026amp; scattering_pdf \u0026gt; \u003cspan class=\"tn\"\u003e0\u003c/span\u003e \u0026amp;\u0026amp; world.\u003cspan class=\"tf\"\u003ehit\u003c/span\u003e(shadow, Interval{kShadowEpsilon, kInfinity}, lrec)) {",
        "        \u003cspan class=\"tk\"\u003econst\u003c/span\u003e Color emitted = lrec.mat-\u0026gt;\u003cspan class=\"tf\"\u003eemitted\u003c/span\u003e(shadow, lrec);",
        "        \u003cspan class=\"tk\"\u003econst\u003c/span\u003e \u003cspan class=\"tt\"\u003edouble\u003c/span\u003e weight = \u003cspan class=\"tf\"\u003epower_heuristic\u003c/span\u003e(light_pdf, srec.pdf-\u0026gt;\u003cspan class=\"tf\"\u003evalue\u003c/span\u003e(to_light));",
        "        radiance += throughput * srec.attenuation * emitted * (scattering_pdf * weight / light_pdf);",
        "      }",
        "    }",
        "",
        "    \u003cspan class=\"tk\"\u003econst\u003c/span\u003e Vec3 direction = srec.pdf-\u0026gt;\u003cspan class=\"tf\"\u003egenerate\u003c/span\u003e(rng);",
        "    \u003cspan class=\"tk\"\u003econst\u003c/span\u003e \u003cspan class=\"tt\"\u003edouble\u003c/span\u003e pdf_value = srec.pdf-\u0026gt;\u003cspan class=\"tf\"\u003evalue\u003c/span\u003e(direction);",
        "    \u003cspan class=\"tk\"\u003econst\u003c/span\u003e Ray scattered{rec.p, direction, ray.time};",
        "    \u003cspan class=\"tk\"\u003econst\u003c/span\u003e \u003cspan class=\"tt\"\u003edouble\u003c/span\u003e scattering_pdf = rec.mat-\u0026gt;\u003cspan class=\"tf\"\u003escattering_pdf\u003c/span\u003e(ray, rec, scattered);",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e (!(pdf_value \u0026gt; \u003cspan class=\"tn\"\u003e0\u003c/span\u003e) || scattering_pdf \u0026lt;= \u003cspan class=\"tn\"\u003e0\u003c/span\u003e) \u003cspan class=\"tk\"\u003ebreak\u003c/span\u003e;",
        "    throughput = throughput * srec.attenuation * (scattering_pdf / pdf_value);",
        "    weigh_emission = lights != nullptr;",
        "    bounce_pdf = pdf_value;",
        "    bounce_origin = rec.p;",
        "    ray = scattered;",
        "",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e (hit \u0026gt;= kRouletteStart) {",
        "      \u003cspan class=\"tk\"\u003econst\u003c/span\u003e \u003cspan class=\"tt\"\u003edouble\u003c/span\u003e survive = std::\u003cspan class=\"tf\"\u003emin\u003c/span\u003e(\u003cspan class=\"tn\"\u003e0.95\u003c/span\u003e, std::\u003cspan class=\"tf\"\u003emax\u003c/span\u003e({throughput.x, throughput.y, throughput.z}));",
        "      \u003cspan class=\"tk\"\u003eif\u003c/span\u003e (rng.\u003cspan class=\"tf\"\u003euniform\u003c/span\u003e() \u0026gt;= survive) \u003cspan class=\"tk\"\u003ebreak\u003c/span\u003e;",
        "      throughput = throughput / survive;",
        "    }",
        "  }",
        "  \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e radiance;",
        "}"
      ]
    }
