      "path": "crates/keel-sim/src/world.rs",
      "from": 151,
      "to": 167,
      "title": "Trace hash",
      "why": "Every traced event folds into one running hash, so two runs of the same seed can be compared bit for bit.",
      "calls": [
        "run"
      ],
      "text": [
        "    pub fn trace(\u0026self, tag: Tag, a: u64, b: u64) {",
        "        let mut h = self.trace_hash.get();",
        "        for word in [tag as u64, self.now.get(), a, b] {",
        "            h ^= word;",
        "            h = h.wrapping_mul(0x9e37_79b9_7f4a_7c15);",
        "            h ^= h \u003e\u003e 29;",
        "        }",
        "        self.trace_hash.set(h);",
        "        if self.cfg.record_trace {",
        "            self.trace_log.borrow_mut().push(TraceEntry {",
        "                now: self.now.get(),",
        "                kind: tag_name(tag),",
        "                a,",
        "                b,",
        "            });",
        "        }",
        "    }"
      ],
      "lines": [
        "\u003cspan class=\"tk\"\u003epub\u003c/span\u003e \u003cspan class=\"tk\"\u003efn\u003c/span\u003e \u003cspan class=\"tf\"\u003etrace\u003c/span\u003e(\u0026amp;self, tag: \u003cspan class=\"tt\"\u003eTag\u003c/span\u003e, a: \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e, b: \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e) {",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e h = self.trace_hash.get();",
        "    \u003cspan class=\"tk\"\u003efor\u003c/span\u003e word \u003cspan class=\"tk\"\u003ein\u003c/span\u003e [tag \u003cspan class=\"tk\"\u003eas\u003c/span\u003e \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e, self.now.get(), a, b] {",
        "        h ^= word;",
        "        h = h.wrapping_mul(\u003cspan class=\"tn\"\u003e0x9e37_79b9_7f4a_7c15\u003c/span\u003e);",
        "        h ^= h \u0026gt;\u0026gt; \u003cspan class=\"tn\"\u003e29\u003c/span\u003e;",
        "    }",
        "    self.trace_hash.set(h);",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e self.cfg.record_trace {",
        "        self.trace_log.borrow_mut().push(TraceEntry {",
        "            now: \u003cspan class=\"tt\"\u003eself\u003c/span\u003e.now.get(),",
        "            kind: \u003cspan class=\"tt\"\u003etag_name\u003c/span\u003e(tag),",
        "            a,",
        "            b,",
        "        });",
        "    }",
        "}"
      ]
    },
    {
      "path": "crates/keel-sim/src/world.rs",
      "from": 273,
      "to": 298,
      "title": "Seeded task scheduler",
      "why": "The next task is drawn from the seeded RNG among tasks on running nodes, so interleavings vary per seed yet replay exactly.",
      "calls": [
        "run"
      ],
      "text": [
        "    fn pick_runnable(\u0026self) -\u003e Option\u003cu64\u003e {",
        "        let mut ready = self.ready.lock().unwrap_or_else(PoisonError::into_inner);",
        "        if ready.is_empty() {",
        "            return None;",
        "        }",
        "        let tasks = self.tasks.borrow();",
        "        let nodes = self.nodes.borrow();",
        "        ready.retain(|id| tasks.contains_key(id));",
        "        let runnable: Vec\u003cu64\u003e = ready",
        "            .iter()",
        "            .copied()",
        "            .filter(|id| {",
        "                tasks.get(id).is_some_and(|slot| {",
        "                    nodes.get(\u0026slot.node).is_none_or(|n| n.status == Status::Up)",
        "                })",
        "            })",
        "            .collect();",
        "        if runnable.is_empty() {",
        "            return None;",
        "        }",
        "        let len = u64::try_from(runnable.len()).unwrap_or(u64::MAX);",
        "        let idx = usize::try_from(self.rng.borrow_mut().below(len)).unwrap_or(0);",
        "        let id = runnable[idx];",
        "        ready.remove(\u0026id);",
        "        Some(id)",
        "    }"
      ],
      "lines": [
        "\u003cspan class=\"tk\"\u003efn\u003c/span\u003e \u003cspan class=\"tf\"\u003epick_runnable\u003c/span\u003e(\u0026amp;self) -\u0026gt; \u003cspan class=\"tt\"\u003eOption\u003c/span\u003e\u0026lt;\u003cspan class=\"tt\"\u003eu64\u003c/span\u003e\u0026gt; {",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e ready = self.ready.lock().unwrap_or_else(PoisonError::into_inner);",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e ready.is_empty() {",
        "        \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tt\"\u003eNone\u003c/span\u003e;",
        "    }",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e tasks = self.tasks.borrow();",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e nodes = self.nodes.borrow();",
        "    ready.retain(|id| tasks.contains_key(id));",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e runnable: \u003cspan class=\"tt\"\u003eVec\u003c/span\u003e\u0026lt;\u003cspan class=\"tt\"\u003eu64\u003c/span\u003e\u0026gt; = ready",
        "        .iter()",
        "        .copied()",
        "        .filter(|id| {",
        "            tasks.get(id).is_some_and(|slot| {",
        "                nodes.get(\u0026amp;slot.node).is_none_or(|n| n.status == Status::Up)",
        "            })",
        "        })",
        "        .collect();",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e runnable.is_empty() {",
        "        \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tt\"\u003eNone\u003c/span\u003e;",
        "    }",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e len = \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e::try_from(runnable.len()).unwrap_or(\u003cspan class=\"tt\"\u003eu64\u003c/span\u003e::MAX);",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e idx = \u003cspan class=\"tt\"\u003eusize\u003c/span\u003e::try_from(self.rng.borrow_mut().below(len)).unwrap_or(\u003cspan class=\"tn\"\u003e0\u003c/span\u003e);",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e id = runnable[idx];",
        "    ready.remove(\u0026amp;id);",
        "    \u003cspan class=\"tt\"\u003eSome\u003c/span\u003e(id)",
        "}"
      ]
    },
    {
      "path": "crates/keel-sim/src/nemesis.rs",
      "from": 174,
      "to": 188,
      "title": "Nemesis fault loop",
      "why": "Faults fire at random virtual-time intervals drawn from the simulation's own PRNG, so a seed replays the same fault schedule.",
      "calls": [
        "run"
      ],
      "text": [
        "    /// Runs the simulation for `d`, acting at random intervals.",
        "    pub fn run(\u0026self, sim: \u0026Sim, d: Duration) -\u003e Result\u003c(), SimError\u003e {",
        "        let end = sim.now().saturating_add(d);",
        "        while sim.now() \u003c end {",
        "            let lo = u64::try_from(self.cfg.min_interval.as_nanos()).unwrap_or(u64::MAX);",
        "            let hi = u64::try_from(self.cfg.max_interval.as_nanos()).unwrap_or(u64::MAX);",
        "            let wait = lo + sim.random_below(hi.saturating_sub(lo) + 1);",
        "            let left = end.saturating_duration_since(sim.now());",
        "            sim.run_for(Duration::from_nanos(wait).min(left))?;",
        "            if sim.now() \u003c end {",
        "                self.act(sim);",
        "            }",
        "        }",
        "        Ok(())",
        "    }"
      ],
      "lines": [
        "\u003cspan class=\"ts\"\u003e/// Runs the simulation for `d`, acting at random intervals.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003epub\u003c/span\u003e \u003cspan class=\"tk\"\u003efn\u003c/span\u003e \u003cspan class=\"tf\"\u003erun\u003c/span\u003e(\u0026amp;self, sim: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"tt\"\u003eSim\u003c/span\u003e, d: \u003cspan class=\"tt\"\u003eDuration\u003c/span\u003e) -\u0026gt; \u003cspan class=\"tt\"\u003eResult\u003c/span\u003e\u0026lt;(), SimError\u0026gt; {",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e end = sim.now().saturating_add(d);",
        "    \u003cspan class=\"tk\"\u003ewhile\u003c/span\u003e sim.now() \u0026lt; end {",
        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e lo = \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e::try_from(self.cfg.min_interval.as_nanos()).unwrap_or(\u003cspan class=\"tt\"\u003eu64\u003c/span\u003e::MAX);",
        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e hi = \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e::try_from(self.cfg.max_interval.as_nanos()).unwrap_or(\u003cspan class=\"tt\"\u003eu64\u003c/span\u003e::MAX);",
        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e wait = lo + sim.random_below(hi.saturating_sub(lo) + \u003cspan class=\"tn\"\u003e1\u003c/span\u003e);",
        "        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e left = end.saturating_duration_since(sim.now());",
        "        sim.run_for(Duration::from_nanos(wait).min(left))?;",
        "        \u003cspan class=\"tk\"\u003eif\u003c/span\u003e sim.now() \u0026lt; end {",
        "            self.act(sim);",
        "        }",
        "    }",
        "    \u003cspan class=\"tt\"\u003eOk\u003c/span\u003e(())",
        "}"
      ]
    }
