    {
      "path": "internal/xlate/xlate.go",
      "from": 285,
      "to": 327,
      "title": "Forward with _meta or refuse",
      "why": "Answers ping and setLevel itself, forwards known methods with the per-request _meta injected, and refuses the rest as unsupported.",
      "calls": [],
      "text": [
        "func (t *Translator) clientRequest(f *wire.Frame) Actions {",
        "\tvar acts Actions",
        "\tswitch {",
        "\tcase f.Method == \"initialize\":",
        "\t\tacts.client(wire.NewError(f.ID, -32600, \"mcpbridge: session already initialized\"))",
        "\tcase f.Method == \"ping\":",
        "\t\t// Removed in 2026-07-28 (SEP-2575); the bridge answers it itself.",
        "\t\tt.trace(\"shim: answering legacy ping locally\")",
        "\t\tacts.client(wire.NewResult(f.ID, nil))",
        "\tcase f.Method == \"logging/setLevel\":",
        "\t\tvar p struct {",
        "\t\t\tLevel string `json:\"level\"`",
        "\t\t}",
        "\t\tif err := json.Unmarshal(f.Params, \u0026p); err != nil || p.Level == \"\" {",
        "\t\t\tacts.client(wire.NewError(f.ID, -32602, \"mcpbridge: logging/setLevel requires a level\"))",
        "\t\t\treturn acts",
        "\t\t}",
        "\t\tt.sess.LogLevel = p.Level",
        "\t\tt.trace(\"shim: logging/setLevel(%s) -\u003e per-request %s\", p.Level, wirenew.MetaLogLevel)",
        "\t\tacts.client(wire.NewResult(f.ID, nil))",
        "\tcase f.Method == \"resources/subscribe\":",
        "\t\treturn t.clientSubscribe(f)",
        "\tcase f.Method == \"resources/unsubscribe\":",
        "\t\treturn t.clientUnsubscribe(f)",
        "\tcase forwardable[f.Method]:",
        "\t\tparams, err := wirenew.InjectMeta(f.Params, t.meta())",
        "\t\tif err != nil {",
        "\t\t\tacts.client(wire.NewError(f.ID, -32602, \"mcpbridge: \"+err.Error()))",
        "\t\t\treturn acts",
        "\t\t}",
        "\t\tpending := \u0026session.Pending{Kind: session.Forward, Method: f.Method, ClientID: f.ID, Params: params}",
        "\t\tif err := t.sess.AddPendingServer(f.ID, pending); err != nil {",
        "\t\t\tacts.client(wire.NewError(f.ID, -32600, \"mcpbridge: request id already in flight\"))",
        "\t\t\treturn acts",
        "\t\t}",
        "\t\tacts.server(wire.NewRequest(f.ID, f.Method, params))",
        "\tdefault:",
        "\t\tt.trace(\"unsupported client method %q rejected\", f.Method)",
        "\t\tacts.client(wire.NewError(f.ID, -32601,",
        "\t\t\tfmt.Sprintf(\"mcpbridge: unsupported: %s has no faithful 2026-07-28 translation (see docs/mapping.md)\", f.Method)))",
        "\t}",
        "\treturn acts",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (t *Translator) \u003cspan class=\"tf\"\u003eclientRequest\u003c/span\u003e(f *wire.Frame) Actions {",
        "\t\u003cspan class=\"tk\"\u003evar\u003c/span\u003e acts Actions",
        "\t\u003cspan class=\"tk\"\u003eswitch\u003c/span\u003e {",
        "\t\u003cspan class=\"tk\"\u003ecase\u003c/span\u003e f.Method == \u003cspan class=\"ts\"\u003e\u0026#34;initialize\u0026#34;\u003c/span\u003e:",
        "\t\tacts.\u003cspan class=\"tf\"\u003eclient\u003c/span\u003e(wire.\u003cspan class=\"tf\"\u003eNewError\u003c/span\u003e(f.ID, -\u003cspan class=\"tn\"\u003e32600\u003c/span\u003e, \u003cspan class=\"ts\"\u003e\u0026#34;mcpbridge: session already initialized\u0026#34;\u003c/span\u003e))",
        "\t\u003cspan class=\"tk\"\u003ecase\u003c/span\u003e f.Method == \u003cspan class=\"ts\"\u003e\u0026#34;ping\u0026#34;\u003c/span\u003e:",
        "\t\t\u003cspan class=\"tc\"\u003e// Removed in 2026-07-28 (SEP-2575); the bridge answers it itself.\u003c/span\u003e",
        "\t\tt.\u003cspan class=\"tf\"\u003etrace\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;shim: answering legacy ping locally\u0026#34;\u003c/span\u003e)",
        "\t\tacts.\u003cspan class=\"tf\"\u003eclient\u003c/span\u003e(wire.\u003cspan class=\"tf\"\u003eNewResult\u003c/span\u003e(f.ID, \u003cspan class=\"tk\"\u003enil\u003c/span\u003e))",
        "\t\u003cspan class=\"tk\"\u003ecase\u003c/span\u003e f.Method == \u003cspan class=\"ts\"\u003e\u0026#34;logging/setLevel\u0026#34;\u003c/span\u003e:",
        "\t\t\u003cspan class=\"tk\"\u003evar\u003c/span\u003e p \u003cspan class=\"tk\"\u003estruct\u003c/span\u003e {",
        "\t\t\tLevel \u003cspan class=\"tt\"\u003estring\u003c/span\u003e \u003cspan class=\"ts\"\u003e`json:\u0026#34;level\u0026#34;`\u003c/span\u003e",
        "\t\t}",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err := json.\u003cspan class=\"tf\"\u003eUnmarshal\u003c/span\u003e(f.Params, \u0026amp;p); err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e || p.Level == \u003cspan class=\"ts\"\u003e\u0026#34;\u0026#34;\u003c/span\u003e {",
        "\t\t\tacts.\u003cspan class=\"tf\"\u003eclient\u003c/span\u003e(wire.\u003cspan class=\"tf\"\u003eNewError\u003c/span\u003e(f.ID, -\u003cspan class=\"tn\"\u003e32602\u003c/span\u003e, \u003cspan class=\"ts\"\u003e\u0026#34;mcpbridge: logging/setLevel requires a level\u0026#34;\u003c/span\u003e))",
        "\t\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e acts",
        "\t\t}",
        "\t\tt.sess.LogLevel = p.Level",
        "\t\tt.\u003cspan class=\"tf\"\u003etrace\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;shim: logging/setLevel(%s) -\u0026gt; per-request %s\u0026#34;\u003c/span\u003e, p.Level, wirenew.MetaLogLevel)",
        "\t\tacts.\u003cspan class=\"tf\"\u003eclient\u003c/span\u003e(wire.\u003cspan class=\"tf\"\u003eNewResult\u003c/span\u003e(f.ID, \u003cspan class=\"tk\"\u003enil\u003c/span\u003e))",
        "\t\u003cspan class=\"tk\"\u003ecase\u003c/span\u003e f.Method == \u003cspan class=\"ts\"\u003e\u0026#34;resources/subscribe\u0026#34;\u003c/span\u003e:",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e t.\u003cspan class=\"tf\"\u003eclientSubscribe\u003c/span\u003e(f)",
        "\t\u003cspan class=\"tk\"\u003ecase\u003c/span\u003e f.Method == \u003cspan class=\"ts\"\u003e\u0026#34;resources/unsubscribe\u0026#34;\u003c/span\u003e:",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e t.\u003cspan class=\"tf\"\u003eclientUnsubscribe\u003c/span\u003e(f)",
        "\t\u003cspan class=\"tk\"\u003ecase\u003c/span\u003e forwardable[f.Method]:",
        "\t\tparams, err := wirenew.\u003cspan class=\"tf\"\u003eInjectMeta\u003c/span\u003e(f.Params, t.\u003cspan class=\"tf\"\u003emeta\u003c/span\u003e())",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\tacts.\u003cspan class=\"tf\"\u003eclient\u003c/span\u003e(wire.\u003cspan class=\"tf\"\u003eNewError\u003c/span\u003e(f.ID, -\u003cspan class=\"tn\"\u003e32602\u003c/span\u003e, \u003cspan class=\"ts\"\u003e\u0026#34;mcpbridge: \u0026#34;\u003c/span\u003e+err.\u003cspan class=\"tf\"\u003eError\u003c/span\u003e()))",
        "\t\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e acts",
        "\t\t}",
        "\t\tpending := \u0026amp;session.Pending{Kind: session.Forward, Method: f.Method, ClientID: f.ID, Params: params}",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err := t.sess.\u003cspan class=\"tf\"\u003eAddPendingServer\u003c/span\u003e(f.ID, pending); err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\tacts.\u003cspan class=\"tf\"\u003eclient\u003c/span\u003e(wire.\u003cspan class=\"tf\"\u003eNewError\u003c/span\u003e(f.ID, -\u003cspan class=\"tn\"\u003e32600\u003c/span\u003e, \u003cspan class=\"ts\"\u003e\u0026#34;mcpbridge: request id already in flight\u0026#34;\u003c/span\u003e))",
        "\t\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e acts",
        "\t\t}",
        "\t\tacts.\u003cspan class=\"tf\"\u003eserver\u003c/span\u003e(wire.\u003cspan class=\"tf\"\u003eNewRequest\u003c/span\u003e(f.ID, f.Method, params))",
        "\t\u003cspan class=\"tk\"\u003edefault\u003c/span\u003e:",
        "\t\tt.\u003cspan class=\"tf\"\u003etrace\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;unsupported client method %q rejected\u0026#34;\u003c/span\u003e, f.Method)",
        "\t\tacts.\u003cspan class=\"tf\"\u003eclient\u003c/span\u003e(wire.\u003cspan class=\"tf\"\u003eNewError\u003c/span\u003e(f.ID, -\u003cspan class=\"tn\"\u003e32601\u003c/span\u003e,",
        "\t\t\tfmt.\u003cspan class=\"tf\"\u003eSprintf\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;mcpbridge: unsupported: %s has no faithful 2026-07-28 translation (see docs/mapping.md)\u0026#34;\u003c/span\u003e, f.Method)))",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e acts",
        "}"
      ]
    },
    {
      "path": "internal/wire/frame.go",
      "from": 53,
      "to": 63,
      "title": "Every frame is parsed first",
      "why": "Every frame is decoded here first, and anything that is not JSON-RPC 2.0 comes back as an error instead of being guessed at.",
      "calls": [
        "send"
      ],
      "text": [
        "// Parse decodes one newline-delimited JSON-RPC message.",
        "func Parse(line []byte) (*Frame, error) {",
        "\tvar f Frame",
        "\tif err := json.Unmarshal(line, \u0026f); err != nil {",
        "\t\treturn nil, fmt.Errorf(\"malformed JSON-RPC frame: %w\", err)",
        "\t}",
        "\tif f.JSONRPC != \"2.0\" {",
        "\t\treturn nil, fmt.Errorf(\"frame is not JSON-RPC 2.0 (jsonrpc=%q)\", f.JSONRPC)",
        "\t}",
        "\treturn \u0026f, nil",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// Parse decodes one newline-delimited JSON-RPC message.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e \u003cspan class=\"tf\"\u003eParse\u003c/span\u003e(line []\u003cspan class=\"tt\"\u003ebyte\u003c/span\u003e) (*Frame, \u003cspan class=\"tt\"\u003eerror\u003c/span\u003e) {",
        "\t\u003cspan class=\"tk\"\u003evar\u003c/span\u003e f Frame",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err := json.\u003cspan class=\"tf\"\u003eUnmarshal\u003c/span\u003e(line, \u0026amp;f); err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tk\"\u003enil\u003c/span\u003e, fmt.\u003cspan class=\"tf\"\u003eErrorf\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;malformed JSON-RPC frame: %w\u0026#34;\u003c/span\u003e, err)",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e f.JSONRPC != \u003cspan class=\"ts\"\u003e\u0026#34;2.0\u0026#34;\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tk\"\u003enil\u003c/span\u003e, fmt.\u003cspan class=\"tf\"\u003eErrorf\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;frame is not JSON-RPC 2.0 (jsonrpc=%q)\u0026#34;\u003c/span\u003e, f.JSONRPC)",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u0026amp;f, \u003cspan class=\"tk\"\u003enil\u003c/span\u003e",
        "}"
      ]
    }
