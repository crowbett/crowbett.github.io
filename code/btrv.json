    {
      "path": "internal/export/export.go",
      "from": 426,
      "to": 450,
      "title": "Counting column errors",
      "why": "A row whose columns fail to decode is still written; each failed column is counted and the first errors are kept word for word.",
      "calls": [],
      "text": [
        "// AddRowError records the column errors of row (1-based). err may be an errors.Join of",
        "// several column errors; each counts separately.",
        "func (r *Report) AddRowError(row int64, err error) {",
        "\tif err == nil {",
        "\t\treturn",
        "\t}",
        "\tr.RowsWithErrors++",
        "\terrs := []error{err}",
        "\t// Only a top-level errors.Join (what ddf.decode returns for a row) is split into its",
        "\t// column errors. A single column error that itself wraps a join is one failure;",
        "\t// errors.As would reach through to the inner join and count it several times.",
        "\tif joined, ok := err.(interface{ Unwrap() []error }); ok {",
        "\t\terrs = joined.Unwrap()",
        "\t}",
        "\tlimit := r.MaxErrors",
        "\tif limit \u003c= 0 {",
        "\t\tlimit = DefaultMaxErrors",
        "\t}",
        "\tfor _, e := range errs {",
        "\t\tr.ColumnErrors++",
        "\t\tif len(r.Errors) \u003c limit {",
        "\t\t\tr.Errors = append(r.Errors, fmt.Sprintf(\"row %d: %v\", row, e))",
        "\t\t}",
        "\t}",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// AddRowError records the column errors of row (1-based). err may be an errors.Join of\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// several column errors; each counts separately.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (r *Report) \u003cspan class=\"tf\"\u003eAddRowError\u003c/span\u003e(row \u003cspan class=\"tt\"\u003eint64\u003c/span\u003e, err \u003cspan class=\"tt\"\u003eerror\u003c/span\u003e) {",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err == \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e",
        "\t}",
        "\tr.RowsWithErrors++",
        "\terrs := []\u003cspan class=\"tt\"\u003eerror\u003c/span\u003e{err}",
        "\t\u003cspan class=\"tc\"\u003e// Only a top-level errors.Join (what ddf.decode returns for a row) is split into its\u003c/span\u003e",
        "\t\u003cspan class=\"tc\"\u003e// column errors. A single column error that itself wraps a join is one failure;\u003c/span\u003e",
        "\t\u003cspan class=\"tc\"\u003e// errors.As would reach through to the inner join and count it several times.\u003c/span\u003e",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e joined, ok := err.(\u003cspan class=\"tk\"\u003einterface\u003c/span\u003e{ \u003cspan class=\"tf\"\u003eUnwrap\u003c/span\u003e() []\u003cspan class=\"tt\"\u003eerror\u003c/span\u003e }); ok {",
        "\t\terrs = joined.\u003cspan class=\"tf\"\u003eUnwrap\u003c/span\u003e()",
        "\t}",
        "\tlimit := r.MaxErrors",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e limit \u0026lt;= \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\tlimit = DefaultMaxErrors",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003efor\u003c/span\u003e _, e := \u003cspan class=\"tk\"\u003erange\u003c/span\u003e errs {",
        "\t\tr.ColumnErrors++",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(r.Errors) \u0026lt; limit {",
        "\t\t\tr.Errors = \u003cspan class=\"tt\"\u003eappend\u003c/span\u003e(r.Errors, fmt.\u003cspan class=\"tf\"\u003eSprintf\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;row %d: %v\u0026#34;\u003c/span\u003e, row, e))",
        "\t\t}",
        "\t}",
        "}"
      ]
