      "path": "internal/page/walk.go",
      "from": 440,
      "to": 472,
      "title": "Walking the data pages",
      "why": "Each data page the PAT maps must carry the logical page number it is mapped as, or the read stops instead of yielding garbage rows.",
      "calls": [
        "sample"
      ],
      "text": [
        "// walkPAT walks a 6.x-9.x file: every PAT entry typed as a data page maps a logical page",
        "// to a physical page; each slot starts with a u16 usage count that is zero for an empty",
        "// or deleted slot.",
        "func (f *File) walkPAT(ctx context.Context, emit emitFunc, l patLayout) error {",
        "\th := f.hdr",
        "\tps := int64(h.pageSize)",
        "\tskip := h.recordOverhead()",
        "\tbuf := make([]byte, h.pageSize)",
        "\trd := newPageReader(f)",
        "\treturn f.forEachPATEntry(ctx, l, func(lp, phys int64, typ int) error {",
        "\t\tif typ != pageTypeData {",
        "\t\t\treturn nil",
        "\t\t}",
        "\t\tif err := ctx.Err(); err != nil {",
        "\t\t\treturn err",
        "\t\t}",
        "\t\tif err := rd.readInto(buf, phys*ps); err != nil {",
        "\t\t\treturn err",
        "\t\t}",
        "\t\tif !l.isData(buf, lp) {",
        "\t\t\treturn fmt.Errorf(\"%w: PAT maps logical page %d to physical page %d, which is not that data page\", ErrCorrupt, lp, phys)",
        "\t\t}",
        "\t\tfor off := l.dataHeader; off+h.physLen \u003c= h.pageSize; off += h.physLen {",
        "\t\t\tif u16(buf, off) == 0 {",
        "\t\t\t\tcontinue",
        "\t\t\t}",
        "\t\t\tif !emit(buf[off+skip : off+h.physLen]) {",
        "\t\t\t\treturn errStop",
        "\t\t\t}",
        "\t\t}",
        "\t\treturn nil",
        "\t})",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// walkPAT walks a 6.x-9.x file: every PAT entry typed as a data page maps a logical page\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// to a physical page; each slot starts with a u16 usage count that is zero for an empty\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// or deleted slot.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (f *File) \u003cspan class=\"tf\"\u003ewalkPAT\u003c/span\u003e(ctx context.Context, emit emitFunc, l patLayout) \u003cspan class=\"tt\"\u003eerror\u003c/span\u003e {",
        "\th := f.hdr",
        "\tps := \u003cspan class=\"tt\"\u003eint64\u003c/span\u003e(h.pageSize)",
        "\tskip := h.\u003cspan class=\"tf\"\u003erecordOverhead\u003c/span\u003e()",
        "\tbuf := \u003cspan class=\"tt\"\u003emake\u003c/span\u003e([]\u003cspan class=\"tt\"\u003ebyte\u003c/span\u003e, h.pageSize)",
        "\trd := \u003cspan class=\"tf\"\u003enewPageReader\u003c/span\u003e(f)",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e f.\u003cspan class=\"tf\"\u003eforEachPATEntry\u003c/span\u003e(ctx, l, \u003cspan class=\"tk\"\u003efunc\u003c/span\u003e(lp, phys \u003cspan class=\"tt\"\u003eint64\u003c/span\u003e, typ \u003cspan class=\"tt\"\u003eint\u003c/span\u003e) \u003cspan class=\"tt\"\u003eerror\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e typ != pageTypeData {",
        "\t\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tk\"\u003enil\u003c/span\u003e",
        "\t\t}",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err := ctx.\u003cspan class=\"tf\"\u003eErr\u003c/span\u003e(); err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e err",
        "\t\t}",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err := rd.\u003cspan class=\"tf\"\u003ereadInto\u003c/span\u003e(buf, phys*ps); err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e err",
        "\t\t}",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e !l.\u003cspan class=\"tf\"\u003eisData\u003c/span\u003e(buf, lp) {",
        "\t\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e fmt.\u003cspan class=\"tf\"\u003eErrorf\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;%w: PAT maps logical page %d to physical page %d, which is not that data page\u0026#34;\u003c/span\u003e, ErrCorrupt, lp, phys)",
        "\t\t}",
        "\t\t\u003cspan class=\"tk\"\u003efor\u003c/span\u003e off := l.dataHeader; off+h.physLen \u0026lt;= h.pageSize; off += h.physLen {",
        "\t\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e \u003cspan class=\"tf\"\u003eu16\u003c/span\u003e(buf, off) == \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\t\t\t\u003cspan class=\"tk\"\u003econtinue\u003c/span\u003e",
