      "path": "internal/raft/raft.go",
      "from": 705,
      "to": 727,
      "title": "Commit only through the current term",
      "why": "The leader commits the highest index a quorum holds, but only through an entry of its own term: the Raft paper's Figure 8 case.",
      "calls": [],
      "text": [
        "// maybeCommit advances the commit index to the highest index durable on a quorum,",
        "// but only through an entry of the current term (Figure 8).",
        "// A leader that is not a voter (it removed itself) does not count its own log, and",
        "// steps down once that removal commits.",
        "func (r *Raft) maybeCommit() bool {",
        "\tmatches := make([]uint64, 0, len(r.conf.Voters))",
        "\tfor _, id := range r.conf.Voters {",
        "\t\tmatches = append(matches, r.prs[id].match)",
        "\t}",
        "\tslices.Sort(matches)",
        "\tq := matches[len(matches)-r.quorum()]",
        "\tif q \u003c= r.log.committed || r.log.mustTerm(q) != r.term {",
        "\t\treturn false",
        "\t}",
        "\tr.log.commitTo(q)",
        "\tr.issueHeldReads()",
        "\tif !r.conf.IsVoter(r.id) \u0026\u0026 r.log.committed \u003e= r.log.lastConfIndex() {",
        "\t\tr.bcastAppend() // tell the others about the commit before leaving",
        "\t\tr.becomeFollower(r.term, None)",
        "\t\treturn false",
        "\t}",
        "\treturn true",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// maybeCommit advances the commit index to the highest index durable on a quorum,\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// but only through an entry of the current term (Figure 8).\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// A leader that is not a voter (it removed itself) does not count its own log, and\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// steps down once that removal commits.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (r *Raft) \u003cspan class=\"tf\"\u003emaybeCommit\u003c/span\u003e() \u003cspan class=\"tt\"\u003ebool\u003c/span\u003e {",
        "\tmatches := \u003cspan class=\"tt\"\u003emake\u003c/span\u003e([]\u003cspan class=\"tt\"\u003euint64\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(r.conf.Voters))",
        "\t\u003cspan class=\"tk\"\u003efor\u003c/span\u003e _, id := \u003cspan class=\"tk\"\u003erange\u003c/span\u003e r.conf.Voters {",
        "\t\tmatches = \u003cspan class=\"tt\"\u003eappend\u003c/span\u003e(matches, r.prs[id].match)",
        "\t}",
        "\tslices.\u003cspan class=\"tf\"\u003eSort\u003c/span\u003e(matches)",
        "\tq := matches[\u003cspan class=\"tt\"\u003elen\u003c/span\u003e(matches)-r.\u003cspan class=\"tf\"\u003equorum\u003c/span\u003e()]",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e q \u0026lt;= r.log.committed || r.log.\u003cspan class=\"tf\"\u003emustTerm\u003c/span\u003e(q) != r.term {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tk\"\u003efalse\u003c/span\u003e",
        "\t}",
        "\tr.log.\u003cspan class=\"tf\"\u003ecommitTo\u003c/span\u003e(q)",
        "\tr.\u003cspan class=\"tf\"\u003eissueHeldReads\u003c/span\u003e()",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e !r.conf.\u003cspan class=\"tf\"\u003eIsVoter\u003c/span\u003e(r.id) \u0026amp;\u0026amp; r.log.committed \u0026gt;= r.log.\u003cspan class=\"tf\"\u003elastConfIndex\u003c/span\u003e() {",
        "\t\tr.\u003cspan class=\"tf\"\u003ebcastAppend\u003c/span\u003e() \u003cspan class=\"tc\"\u003e// tell the others about the commit before leaving\u003c/span\u003e",
        "\t\tr.\u003cspan class=\"tf\"\u003ebecomeFollower\u003c/span\u003e(r.term, None)",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tk\"\u003efalse\u003c/span\u003e",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tk\"\u003etrue\u003c/span\u003e",
        "}"
      ]
    },
    {
      "path": "internal/sim/sim.go",
      "from": 548,
      "to": 583,
      "title": "Simulated network delivery",
      "why": "Due messages are shuffled by the seeded PRNG and dropped across partitions or cut links, so any reordering replays bit for bit.",
      "calls": [
        "tick"
      ],
      "text": [
        "// deliver hands every due message to its destination, in a random order.",
        "func (c *cluster) deliver() {",
        "\tvar due []envelope",
        "\tkeep := c.net[:0]",
        "\tfor i := range c.net {",
        "\t\tif e := \u0026c.net[i]; e.at \u003c= c.step {",
        "\t\t\tdue = append(due, *e)",
        "\t\t} else {",
        "\t\t\tkeep = append(keep, *e)",
        "\t\t}",
        "\t}",
        "\tc.net = keep",
        "\tc.rng.Shuffle(len(due), func(i, j int) { due[i], due[j] = due[j], due[i] })",
        "\tfor i := range due {",
        "\t\te := \u0026due[i]",
        "\t\tif rep := e.report; rep != nil {",
        "\t\t\tif l := c.byID[rep.leader]; l.r != nil \u0026\u0026 l.incarnation == rep.incarnation {",
        "\t\t\t\tl.r.ReportSnapshot(rep.follower, rep.term, rep.failed)",
        "\t\t\t\tc.logf(\"report snapshot %d-\u003e%d failed=%v\", rep.leader, rep.follower, rep.failed)",
        "\t\t\t}",
        "\t\t\tcontinue",
        "\t\t}",
        "\t\tm := e.m",
        "\t\tto := c.byID[m.To]",
        "\t\tif to.r == nil || c.group[m.From] != c.group[m.To] || c.cut[[2]raft.NodeID{min(m.From, m.To), max(m.From, m.To)}] {",
        "\t\t\tc.res.Dropped++",
        "\t\t\tc.reportSnap(m, true)",
        "\t\t\tcontinue",
        "\t\t}",
        "\t\tc.res.Delivered++",
        "\t\tif err := to.r.Step(m); err != nil {",
        "\t\t\tpanic(err)",
        "\t\t}",
        "\t\tc.reportSnap(m, false)",
        "\t}",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// deliver hands every due message to its destination, in a random order.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (c *cluster) \u003cspan class=\"tf\"\u003edeliver\u003c/span\u003e() {",
        "\t\u003cspan class=\"tk\"\u003evar\u003c/span\u003e due []envelope",
        "\tkeep := c.net[:\u003cspan class=\"tn\"\u003e0\u003c/span\u003e]",
        "\t\u003cspan class=\"tk\"\u003efor\u003c/span\u003e i := \u003cspan class=\"tk\"\u003erange\u003c/span\u003e c.net {",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e e := \u0026amp;c.net[i]; e.at \u0026lt;= c.step {",
        "\t\t\tdue = \u003cspan class=\"tt\"\u003eappend\u003c/span\u003e(due, *e)",
        "\t\t} \u003cspan class=\"tk\"\u003eelse\u003c/span\u003e {",
        "\t\t\tkeep = \u003cspan class=\"tt\"\u003eappend\u003c/span\u003e(keep, *e)",
        "\t\t}",
        "\t}",
        "\tc.net = keep",
        "\tc.rng.\u003cspan class=\"tf\"\u003eShuffle\u003c/span\u003e(\u003cspan class=\"tt\"\u003elen\u003c/span\u003e(due), \u003cspan class=\"tk\"\u003efunc\u003c/span\u003e(i, j \u003cspan class=\"tt\"\u003eint\u003c/span\u003e) { due[i], due[j] = due[j], due[i] })",
        "\t\u003cspan class=\"tk\"\u003efor\u003c/span\u003e i := \u003cspan class=\"tk\"\u003erange\u003c/span\u003e due {",
        "\t\te := \u0026amp;due[i]",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e rep := e.report; rep != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e l := c.byID[rep.leader]; l.r != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e \u0026amp;\u0026amp; l.incarnation == rep.incarnation {",
        "\t\t\t\tl.r.\u003cspan class=\"tf\"\u003eReportSnapshot\u003c/span\u003e(rep.follower, rep.term, rep.failed)",
        "\t\t\t\tc.\u003cspan class=\"tf\"\u003elogf\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;report snapshot %d-\u0026gt;%d failed=%v\u0026#34;\u003c/span\u003e, rep.leader, rep.follower, rep.failed)",
        "\t\t\t}",
        "\t\t\t\u003cspan class=\"tk\"\u003econtinue\u003c/span\u003e",
        "\t\t}",
        "\t\tm := e.m",
        "\t\tto := c.byID[m.To]",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e to.r == \u003cspan class=\"tk\"\u003enil\u003c/span\u003e || c.group[m.From] != c.group[m.To] || c.cut[[\u003cspan class=\"tn\"\u003e2\u003c/span\u003e]raft.NodeID{\u003cspan class=\"tt\"\u003emin\u003c/span\u003e(m.From, m.To), \u003cspan class=\"tt\"\u003emax\u003c/span\u003e(m.From, m.To)}] {",
        "\t\t\tc.res.Dropped++",
        "\t\t\tc.\u003cspan class=\"tf\"\u003ereportSnap\u003c/span\u003e(m, \u003cspan class=\"tk\"\u003etrue\u003c/span\u003e)",
        "\t\t\t\u003cspan class=\"tk\"\u003econtinue\u003c/span\u003e",
        "\t\t}",
        "\t\tc.res.Delivered++",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err := to.r.\u003cspan class=\"tf\"\u003eStep\u003c/span\u003e(m); err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\t\u003cspan class=\"tt\"\u003epanic\u003c/span\u003e(err)",
        "\t\t}",
        "\t\tc.\u003cspan class=\"tf\"\u003ereportSnap\u003c/span\u003e(m, \u003cspan class=\"tk\"\u003efalse\u003c/span\u003e)",
        "\t}",
        "}"
      ]
    }
