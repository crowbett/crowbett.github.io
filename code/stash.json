      ],
      "text": [
        "/// Open, decompress and verify a sealed blob against its id.",
        "pub fn decode_blob(",
        "    keys: \u0026Keys,",
        "    kind: BlobType,",
        "    id: \u0026Id,",
        "    sealed: \u0026[u8],",
        "    raw_len: u32,",
        ") -\u003e Result\u003cVec\u003cu8\u003e\u003e {",
        "    let limit = match kind {",
        "        BlobType::Data =\u003e MAX_DATA_BLOB,",
        "        BlobType::Tree =\u003e MAX_TREE_BLOB,",
        "    };",
        "    if raw_len \u003e limit {",
        "        return Err(Error::Integrity(format!(",
        "            \"blob {}: claimed size {raw_len} exceeds the {} MiB limit\",",
        "            id.short(),",
        "            limit \u003e\u003e 20",
        "        )));",
        "    }",
        "    let framed = keys",
        "        .open(\u0026blob_aad(kind, id), sealed)",
        "        .map_err(|e| in_context(\u0026format!(\"blob {}\", id.short()), e))?;",
        "    let raw = crypto::decompress(\u0026framed, Some(raw_len as usize))",
        "        .map_err(|e| in_context(\u0026format!(\"blob {}\", id.short()), e))?;",
        "    if content_id(keys, kind, \u0026raw) != *id {",
        "        return Err(Error::Integrity(format!(",
        "            \"blob {}: content hash mismatch\",",
        "            id.short()",
        "        )));",
        "    }",
        "    Ok(raw)",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"ts\"\u003e/// Open, decompress and verify a sealed blob against its id.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003epub\u003c/span\u003e \u003cspan class=\"tk\"\u003efn\u003c/span\u003e \u003cspan class=\"tf\"\u003edecode_blob\u003c/span\u003e(",
        "    keys: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"tt\"\u003eKeys\u003c/span\u003e,",
        "    kind: \u003cspan class=\"tt\"\u003eBlobType\u003c/span\u003e,",
        "    id: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"tt\"\u003eId\u003c/span\u003e,",
        "    sealed: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e[\u003cspan class=\"tt\"\u003eu8\u003c/span\u003e],",
        "    raw_len: \u003cspan class=\"tt\"\u003eu32\u003c/span\u003e,",
        ") -\u0026gt; \u003cspan class=\"tt\"\u003eResult\u003c/span\u003e\u0026lt;\u003cspan class=\"tt\"\u003eVec\u003c/span\u003e\u0026lt;\u003cspan class=\"tt\"\u003eu8\u003c/span\u003e\u0026gt;\u0026gt; {",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e limit = \u003cspan class=\"tk\"\u003ematch\u003c/span\u003e kind {",
        "        BlobType::Data =\u0026gt; MAX_DATA_BLOB,",
        "        BlobType::Tree =\u0026gt; MAX_TREE_BLOB,",
        "    };",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e raw_len \u0026gt; limit {",
        "        \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tt\"\u003eErr\u003c/span\u003e(Error::Integrity(\u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(",
        "            \u003cspan class=\"ts\"\u003e\u0026#34;blob \u003c/span\u003e\u003cspan class=\"ts\"\u003e{}\u003c/span\u003e\u003cspan class=\"ts\"\u003e: claimed size \u003c/span\u003e\u003cspan class=\"ts\"\u003e{raw_len}\u003c/span\u003e\u003cspan class=\"ts\"\u003e exceeds the \u003c/span\u003e\u003cspan class=\"ts\"\u003e{}\u003c/span\u003e\u003cspan class=\"ts\"\u003e MiB limit\u0026#34;\u003c/span\u003e,",
        "            id.short(),",
        "            limit \u0026gt;\u0026gt; \u003cspan class=\"tn\"\u003e20\u003c/span\u003e",
        "        )));",
        "    }",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e framed = keys",
        "        .open(\u0026amp;blob_aad(kind, id), sealed)",
        "        .map_err(|e| in_context(\u0026amp;\u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;blob \u003c/span\u003e\u003cspan class=\"ts\"\u003e{}\u003c/span\u003e\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e, id.short()), e))?;",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e raw = crypto::decompress(\u0026amp;framed, \u003cspan class=\"tt\"\u003eSome\u003c/span\u003e(raw_len \u003cspan class=\"tk\"\u003eas\u003c/span\u003e \u003cspan class=\"tt\"\u003eusize\u003c/span\u003e))",
        "        .map_err(|e| in_context(\u0026amp;\u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;blob \u003c/span\u003e\u003cspan class=\"ts\"\u003e{}\u003c/span\u003e\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e, id.short()), e))?;",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e content_id(keys, kind, \u0026amp;raw) != *id {",
        "        \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tt\"\u003eErr\u003c/span\u003e(Error::Integrity(\u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(",
        "            \u003cspan class=\"ts\"\u003e\u0026#34;blob \u003c/span\u003e\u003cspan class=\"ts\"\u003e{}\u003c/span\u003e\u003cspan class=\"ts\"\u003e: content hash mismatch\u0026#34;\u003c/span\u003e,",
        "            id.short()",
        "        )));",
        "    }",
        "    \u003cspan class=\"tt\"\u003eOk\u003c/span\u003e(raw)",
        "}"
      ]
    }
