        "        }",
        "        i += \u003cspan class=\"tn\"\u003e1\u003c/span\u003e;",
        "    }",
        "    \u003cspan class=\"tk\"\u003ewhile\u003c/span\u003e i \u0026lt; end {",
        "        fp = (fp \u0026lt;\u0026lt; \u003cspan class=\"tn\"\u003e1\u003c/span\u003e).wrapping_add(self.gear[data[i] \u003cspan class=\"tk\"\u003eas\u003c/span\u003e \u003cspan class=\"tt\"\u003eusize\u003c/span\u003e]);",
        "        \u003cspan class=\"tk\"\u003eif\u003c/span\u003e fp \u0026amp; self.mask_l == \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "            \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e i + \u003cspan class=\"tn\"\u003e1\u003c/span\u003e;",
        "        }",
        "        i += \u003cspan class=\"tn\"\u003e1\u003c/span\u003e;",
        "    }",
        "    end",
        "}"
      ]
