        "\u003cspan class=\"tk\"\u003epub\u003c/span\u003e \u003cspan class=\"tk\"\u003efn\u003c/span\u003e \u003cspan class=\"tf\"\u003ecut\u003c/span\u003e(\u0026amp;self, data: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e[\u003cspan class=\"tt\"\u003eu8\u003c/span\u003e]) -\u0026gt; \u003cspan class=\"tt\"\u003eusize\u003c/span\u003e {",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e n = data.len();",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e n \u0026lt;= self.min {",
        "        \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e n;",
        "    }",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e end = n.min(self.max);",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e normal = self.avg.min(end);",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e fp: \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e = \u003cspan class=\"tn\"\u003e0\u003c/span\u003e;",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e i = self.min;",
        "    \u003cspan class=\"tk\"\u003ewhile\u003c/span\u003e i \u0026lt; normal {",
        "        fp = (fp \u0026lt;\u0026lt; \u003cspan class=\"tn\"\u003e1\u003c/span\u003e).wrapping_add(self.gear[data[i] \u003cspan class=\"tk\"\u003eas\u003c/span\u003e \u003cspan class=\"tt\"\u003eusize\u003c/span\u003e]);",
        "        \u003cspan class=\"tk\"\u003eif\u003c/span\u003e fp \u0026amp; self.mask_s == \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
