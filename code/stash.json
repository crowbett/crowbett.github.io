      "path": "src/chunker.rs",
      "from": 113,
      "to": 139,
      "title": "FastCDC cut point",
      "why": "Rolls a Gear hash past the minimum size, cutting with a stricter mask before the average size and a looser one after it.",
      "calls": [],
      "text": [
        "    /// Length of the first chunk of `data`. Unless `data` is the tail of the stream, it must hold",
        "    /// at least `max_size` bytes (or the whole remaining stream).",
        "    pub fn cut(\u0026self, data: \u0026[u8]) -\u003e usize {",
        "        let n = data.len();",
        "        if n \u003c= self.min {",
        "            return n;",
        "        }",
        "        let end = n.min(self.max);",
        "        let normal = self.avg.min(end);",
        "        let mut fp: u64 = 0;",
        "        let mut i = self.min;",
        "        while i \u003c normal {",
        "            fp = (fp \u003c\u003c 1).wrapping_add(self.gear[data[i] as usize]);",
        "            if fp \u0026 self.mask_s == 0 {",
        "                return i + 1;",
        "            }",
        "            i += 1;",
        "        }",
        "        while i \u003c end {",
        "            fp = (fp \u003c\u003c 1).wrapping_add(self.gear[data[i] as usize]);",
        "            if fp \u0026 self.mask_l == 0 {",
        "                return i + 1;",
        "            }",
        "            i += 1;",
        "        }",
        "        end",
        "    }"
      ],
      "lines": [
        "\u003cspan class=\"ts\"\u003e/// Length of the first chunk of `data`. Unless `data` is the tail of the stream, it must hold\u003c/span\u003e",
