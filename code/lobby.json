        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e unitOK {",
        "\t\t\u003cspan class=\"tk\"\u003efor\u003c/span\u003e _, u := \u003cspan class=\"tk\"\u003erange\u003c/span\u003e q.cands {",
        "\t\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e u.\u003cspan class=\"tf\"\u003eIsUnit\u003c/span\u003e() \u0026amp;\u0026amp; u.lo \u0026lt;= p \u0026amp;\u0026amp; p \u0026lt;= u.hi \u0026amp;\u0026amp; u.\u003cspan class=\"tf\"\u003eSize\u003c/span\u003e() \u0026lt;= need \u0026amp;\u0026amp; solos \u0026gt;= need-u.\u003cspan class=\"tf\"\u003eSize\u003c/span\u003e() {",
        "\t\t\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e q.\u003cspan class=\"tf\"\u003efill\u003c/span\u003e(a, u, p, need-u.\u003cspan class=\"tf\"\u003eSize\u003c/span\u003e())",
        "\t\t\t}",
        "\t\t}",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e solos \u0026gt;= need {",
