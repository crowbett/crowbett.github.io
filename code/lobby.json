    {
      "path": "internal/match/queue.go",
      "from": 238,
      "to": 268,
      "title": "Exact search when greedy fails",
      "why": "When the greedy chain fails, trying each candidate's lower bound as the shared point finds a group exactly when one exists.",
      "calls": [],
      "text": [
        "\t// Exact search: a valid group's common point is the largest lower bound",
        "\t// among its members (clamped into a's window), so trying every",
        "\t// candidate's clamped lo as the stabbing point finds a group iff one",
        "\t// exists. At a point, solos is the number of solo candidates covering",
        "\t// it; a group exists there iff solos \u003e= need, or some covering unit u",
        "\t// has solos \u003e= need - u.Size(). A unit is preferred (it refills a room",
        "\t// that is already waiting); members are then the first solos covering",
        "\t// the point, in scan order, which keeps the result deterministic.",
        "\tfor i := -1; i \u003c len(q.cands); i++ {",
        "\t\tp := a.lo",
        "\t\tif i \u003e= 0 {",
        "\t\t\tp = max(a.lo, q.cands[i].lo)",
        "\t\t}",
        "\t\tsolos := 0",
        "\t\tfor _, c := range q.cands {",
        "\t\t\tif !c.IsUnit() \u0026\u0026 c.lo \u003c= p \u0026\u0026 p \u003c= c.hi {",
        "\t\t\t\tsolos++",
        "\t\t\t}",
        "\t\t}",
        "\t\tif unitOK {",
        "\t\t\tfor _, u := range q.cands {",
        "\t\t\t\tif u.IsUnit() \u0026\u0026 u.lo \u003c= p \u0026\u0026 p \u003c= u.hi \u0026\u0026 u.Size() \u003c= need \u0026\u0026 solos \u003e= need-u.Size() {",
        "\t\t\t\t\treturn q.fill(a, u, p, need-u.Size())",
        "\t\t\t\t}",
        "\t\t\t}",
        "\t\t}",
        "\t\tif solos \u003e= need {",
        "\t\t\treturn q.fill(a, nil, p, need)",
        "\t\t}",
        "\t}",
        "\treturn nil"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// Exact search: a valid group\u0026#39;s common point is the largest lower bound\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// among its members (clamped into a\u0026#39;s window), so trying every\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// candidate\u0026#39;s clamped lo as the stabbing point finds a group iff one\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// exists. At a point, solos is the number of solo candidates covering\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// it; a group exists there iff solos \u0026gt;= need, or some covering unit u\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// has solos \u0026gt;= need - u.Size(). A unit is preferred (it refills a room\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// that is already waiting); members are then the first solos covering\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// the point, in scan order, which keeps the result deterministic.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efor\u003c/span\u003e i := -\u003cspan class=\"tn\"\u003e1\u003c/span\u003e; i \u0026lt; \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(q.cands); i++ {",
        "\tp := a.lo",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e i \u0026gt;= \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\tp = \u003cspan class=\"tt\"\u003emax\u003c/span\u003e(a.lo, q.cands[i].lo)",
        "\t}",
        "\tsolos := \u003cspan class=\"tn\"\u003e0\u003c/span\u003e",
        "\t\u003cspan class=\"tk\"\u003efor\u003c/span\u003e _, c := \u003cspan class=\"tk\"\u003erange\u003c/span\u003e q.cands {",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e !c.\u003cspan class=\"tf\"\u003eIsUnit\u003c/span\u003e() \u0026amp;\u0026amp; c.lo \u0026lt;= p \u0026amp;\u0026amp; p \u0026lt;= c.hi {",
        "\t\t\tsolos++",
        "\t\t}",
