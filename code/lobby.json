      "path": "internal/match/window.go",
      "from": 8,
      "to": 26,
      "title": "Skill window widens with wait",
      "why": "The window grows linearly with wait and clamps at the max, in integer math, with a float path where the product would overflow.",
      "calls": [
        "reset",
        "join"
      ],
      "text": [
        "// Window returns the skill window for a ticket that has waited wait:",
        "// W0 + (WMax-W0)*min(wait,WidenOver)/WidenOver, in integer points, monotone,",
        "// clamped at WMax. A negative wait counts as zero; a mode with WidenOver \u003c= 0",
        "// is already fully widened.",
        "func Window(m Mode, wait time.Duration) int {",
        "\tif m.WMax \u003c= m.W0 || wait \u003c= 0 {",
        "\t\treturn m.W0",
        "\t}",
        "\tif m.WidenOver \u003c= 0 || wait \u003e= m.WidenOver {",
        "\t\treturn m.WMax",
        "\t}",
        "\tspan := int64(m.WMax - m.W0)",
        "\tif int64(m.WidenOver) \u003e math.MaxInt64/span {",
        "\t\t// Product would overflow (WidenOver in the centuries); the float",
        "\t\t// ratio is exact enough for an integer window.",
        "\t\treturn m.W0 + int(float64(span)*float64(wait)/float64(m.WidenOver))",
        "\t}",
        "\treturn m.W0 + int(span*int64(wait)/int64(m.WidenOver))",
        "}"
      ],
      "lines": [
