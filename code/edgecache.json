        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(cc) == \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tf\"\u003eeachDirective\u003c/span\u003e(h.\u003cspan class=\"tf\"\u003eValues\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;Pragma\u0026#34;\u003c/span\u003e), \u003cspan class=\"tk\"\u003efunc\u003c/span\u003e(name, _ \u003cspan class=\"tt\"\u003estring\u003c/span\u003e, _ \u003cspan class=\"tt\"\u003ebool\u003c/span\u003e) {",
        "\t\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e strings.\u003cspan class=\"tf\"\u003eEqualFold\u003c/span\u003e(name, \u003cspan class=\"ts\"\u003e\u0026#34;no-cache\u0026#34;\u003c/span\u003e) {",
        "\t\t\t\td.NoCache = \u003cspan class=\"tk\"\u003etrue\u003c/span\u003e",
