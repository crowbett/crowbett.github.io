        "\u003cspan class=\"tc\"\u003e-- lease_token is bumped so every claim carries a fresh fencing token.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003eWITH\u003c/span\u003e ready \u003cspan class=\"tk\"\u003eAS\u003c/span\u003e (",
        "    \u003cspan class=\"tk\"\u003eSELECT\u003c/span\u003e jobs.id \u003cspan class=\"tk\"\u003eFROM\u003c/span\u003e jobs",
        "     \u003cspan class=\"tk\"\u003eWHERE\u003c/span\u003e jobs.status = \u003cspan class=\"ts\"\u003e\u0026#39;queued\u0026#39;\u003c/span\u003e \u003cspan class=\"tk\"\u003eAND\u003c/span\u003e jobs.queue = sqlc.\u003cspan class=\"tf\"\u003earg\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#39;queue_name\u0026#39;\u003c/span\u003e) \u003cspan class=\"tk\"\u003eAND\u003c/span\u003e jobs.run_at \u0026lt;= \u003cspan class=\"tf\"\u003enow\u003c/span\u003e()",
        "     \u003cspan class=\"tk\"\u003eORDER\u003c/span\u003e \u003cspan class=\"tk\"\u003eBY\u003c/span\u003e jobs.priority \u003cspan class=\"tk\"\u003eDESC\u003c/span\u003e, jobs.run_at, jobs.id",
        "     \u003cspan class=\"tk\"\u003eLIMIT\u003c/span\u003e sqlc.\u003cspan class=\"tf\"\u003earg\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#39;batch_limit\u0026#39;\u003c/span\u003e)",
