        "       lease_until = \u003cspan class=\"tf\"\u003enow\u003c/span\u003e() + sqlc.\u003cspan class=\"tf\"\u003earg\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#39;ttl\u0026#39;\u003c/span\u003e)::\u003cspan class=\"tk\"\u003einterval\u003c/span\u003e,",
        "       attempts = j.attempts + \u003cspan class=\"tn\"\u003e1\u003c/span\u003e,",
        "       lease_token = j.lease_token + \u003cspan class=\"tn\"\u003e1\u003c/span\u003e,",
        "       started_at = \u003cspan class=\"tf\"\u003eCOALESCE\u003c/span\u003e(j.started_at, \u003cspan class=\"tf\"\u003enow\u003c/span\u003e()),",
