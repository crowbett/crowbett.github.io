    {
      "path": "internal/job/policy.go",
      "from": 66,
      "to": 94,
      "title": "Capped backoff with full jitter",
      "why": "Every retry delay comes from here: a capped exponential ladder, clamped in float64 so any attempt count is safe, then a jitter draw.",
      "calls": [
        "backoff"
      ],
      "text": [
        "// Cap returns the un-jittered ladder value for attempt (1-based), bounded by Max.",
        "// attempt \u003c= 1 yields Base. The exponent is computed in float64 and clamped, so",
        "// any attempt count is safe.",
        "func (p Policy) Cap(attempt int32) time.Duration {",
        "\tp = p.OrDefault()",
        "\tif attempt \u003c= 1 {",
        "\t\treturn min(p.Base, p.Max)",
        "\t}",
        "\td := float64(p.Base) * math.Pow(p.Factor, float64(attempt-1))",
        "\tif math.IsNaN(d) || d \u003e= float64(p.Max) {",
        "\t\treturn p.Max",
        "\t}",
        "\treturn time.Duration(d)",
        "}",
        "",
        "// Next returns the delay before attempt (1-based) runs again. rnd may be nil,",
        "// in which case the process-global generator is used; tests pass a seeded one",
        "// for a deterministic ladder.",
        "func (p Policy) Next(attempt int32, rnd *rand.Rand) time.Duration {",
        "\tp = p.OrDefault()",
        "\tc := p.Cap(attempt)",
        "\tif !p.Jitter || c \u003c= 0 {",
        "\t\treturn c",
        "\t}",
        "\tif rnd == nil {",
        "\t\treturn time.Duration(rand.Int64N(int64(c)))",
        "\t}",
        "\treturn time.Duration(rnd.Int64N(int64(c)))",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// Cap returns the un-jittered ladder value for attempt (1-based), bounded by Max.\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// attempt \u0026lt;= 1 yields Base. The exponent is computed in float64 and clamped, so\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// any attempt count is safe.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (p Policy) \u003cspan class=\"tf\"\u003eCap\u003c/span\u003e(attempt \u003cspan class=\"tt\"\u003eint32\u003c/span\u003e) time.Duration {",
        "\tp = p.\u003cspan class=\"tf\"\u003eOrDefault\u003c/span\u003e()",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e attempt \u0026lt;= \u003cspan class=\"tn\"\u003e1\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tt\"\u003emin\u003c/span\u003e(p.Base, p.Max)",
        "\t}",
        "\td := \u003cspan class=\"tt\"\u003efloat64\u003c/span\u003e(p.Base) * math.\u003cspan class=\"tf\"\u003ePow\u003c/span\u003e(p.Factor, \u003cspan class=\"tt\"\u003efloat64\u003c/span\u003e(attempt-\u003cspan class=\"tn\"\u003e1\u003c/span\u003e))",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e math.\u003cspan class=\"tf\"\u003eIsNaN\u003c/span\u003e(d) || d \u0026gt;= \u003cspan class=\"tt\"\u003efloat64\u003c/span\u003e(p.Max) {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e p.Max",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e time.\u003cspan class=\"tf\"\u003eDuration\u003c/span\u003e(d)",
        "}",
        "",
        "\u003cspan class=\"tc\"\u003e// Next returns the delay before attempt (1-based) runs again. rnd may be nil,\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// in which case the process-global generator is used; tests pass a seeded one\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// for a deterministic ladder.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (p Policy) \u003cspan class=\"tf\"\u003eNext\u003c/span\u003e(attempt \u003cspan class=\"tt\"\u003eint32\u003c/span\u003e, rnd *rand.Rand) time.Duration {",
        "\tp = p.\u003cspan class=\"tf\"\u003eOrDefault\u003c/span\u003e()",
        "\tc := p.\u003cspan class=\"tf\"\u003eCap\u003c/span\u003e(attempt)",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e !p.Jitter || c \u0026lt;= \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e c",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e rnd == \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e time.\u003cspan class=\"tf\"\u003eDuration\u003c/span\u003e(rand.\u003cspan class=\"tf\"\u003eInt64N\u003c/span\u003e(\u003cspan class=\"tt\"\u003eint64\u003c/span\u003e(c)))",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e time.\u003cspan class=\"tf\"\u003eDuration\u003c/span\u003e(rnd.\u003cspan class=\"tf\"\u003eInt64N\u003c/span\u003e(\u003cspan class=\"tt\"\u003eint64\u003c/span\u003e(c)))",
        "}"
