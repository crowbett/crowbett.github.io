        "                \u003cspan class=\"tk\"\u003elet\u003c/span\u003e whole = caps.get(\u003cspan class=\"tn\"\u003e0\u003c/span\u003e).map_or(\u003cspan class=\"ts\"\u003e\u0026#34;\u0026#34;\u003c/span\u003e, |m| m.as_str());",
