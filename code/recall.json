        "\u003cspan class=\"tk\"\u003epub\u003c/span\u003e \u003cspan class=\"tk\"\u003efn\u003c/span\u003e \u003cspan class=\"tf\"\u003eredact\u003c/span\u003e(text: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"tt\"\u003estr\u003c/span\u003e) -\u0026gt; \u003cspan class=\"tt\"\u003eCow\u003c/span\u003e\u0026lt;\u003cspan class=\"tt\"\u003e\u0026#39;_\u003c/span\u003e, \u003cspan class=\"tt\"\u003estr\u003c/span\u003e\u0026gt; {",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e out: \u003cspan class=\"tt\"\u003eCow\u003c/span\u003e\u0026lt;\u003cspan class=\"tt\"\u003e\u0026#39;_\u003c/span\u003e, \u003cspan class=\"tt\"\u003estr\u003c/span\u003e\u0026gt; = Cow::Borrowed(text);",
