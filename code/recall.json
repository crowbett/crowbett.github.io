      "path": "src/query.rs",
      "from": 187,
      "to": 210,
      "title": "Quote-aware query tokenizer",
      "why": "Splits a query on whitespace but keeps quoted phrases and key:\"quoted value\" filters whole; every search is parsed from it.",
      "calls": [
        "search"
      ],
      "text": [
        "/// Whitespace tokenizer that keeps `\"quoted phrases\"` (and `key:\"quoted value\"`) intact.",
        "fn tokenize(s: \u0026str) -\u003e Vec\u003cString\u003e {",
        "    let mut out = Vec::new();",
        "    let mut cur = String::new();",
        "    let mut quoted = false;",
        "    for c in s.chars() {",
        "        match c {",
        "            '\"' =\u003e {",
        "                quoted = !quoted;",
        "                cur.push(c);",
        "            }",
        "            c if c.is_whitespace() \u0026\u0026 !quoted =\u003e {",
        "                if !cur.is_empty() {",
        "                    out.push(std::mem::take(\u0026mut cur));",
        "                }",
        "            }",
        "            c =\u003e cur.push(c),",
        "        }",
        "    }",
        "    if !cur.is_empty() {",
        "        out.push(cur);",
        "    }",
        "    out",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"ts\"\u003e/// Whitespace tokenizer that keeps `\u0026#34;quoted phrases\u0026#34;` (and `key:\u0026#34;quoted value\u0026#34;`) intact.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efn\u003c/span\u003e \u003cspan class=\"tf\"\u003etokenize\u003c/span\u003e(s: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"tt\"\u003estr\u003c/span\u003e) -\u0026gt; \u003cspan class=\"tt\"\u003eVec\u003c/span\u003e\u0026lt;\u003cspan class=\"tt\"\u003eString\u003c/span\u003e\u0026gt; {",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e out = \u003cspan class=\"tt\"\u003eVec\u003c/span\u003e::new();",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e cur = \u003cspan class=\"tt\"\u003eString\u003c/span\u003e::new();",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e quoted = \u003cspan class=\"tk\"\u003efalse\u003c/span\u003e;",
        "    \u003cspan class=\"tk\"\u003efor\u003c/span\u003e c \u003cspan class=\"tk\"\u003ein\u003c/span\u003e s.chars() {",
        "        \u003cspan class=\"tk\"\u003ematch\u003c/span\u003e c {",
        "            \u003cspan class=\"ts\"\u003e\u0026#39;\u0026#34;\u0026#39;\u003c/span\u003e =\u0026gt; {",
        "                quoted = !quoted;",
        "                cur.push(c);",
        "            }",
        "            c \u003cspan class=\"tk\"\u003eif\u003c/span\u003e c.is_whitespace() \u0026amp;\u0026amp; !quoted =\u0026gt; {",
        "                \u003cspan class=\"tk\"\u003eif\u003c/span\u003e !cur.is_empty() {",
        "                    out.push(std::mem::take(\u0026amp;\u003cspan class=\"tk\"\u003emut\u003c/span\u003e cur));",
        "                }",
        "            }",
        "            c =\u0026gt; cur.push(c),",
        "        }",
        "    }",
        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e !cur.is_empty() {",
        "        out.push(cur);",
        "    }",
        "    out",
        "}"
