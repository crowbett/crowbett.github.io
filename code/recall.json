        "                    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e v = v.trim_start_matches([\u003cspan class=\"ts\"\u003e\u0026#39;\u0026#34;\u0026#39;\u003c/span\u003e, \u003cspan class=\"ts\"\u003e\u0026#39;\\\u0026#39;\u0026#39;\u003c/span\u003e]);",
        "                    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e placeholder = v.starts_with(\u003cspan class=\"ts\"\u003e\u0026#34;[REDACTED\u0026#34;\u003c/span\u003e)",
        "                        || v.starts_with(\u003cspan class=\"ts\"\u003e\u0026#34;${\u0026#34;\u003c/span\u003e)",
        "                        || v.starts_with(\u003cspan class=\"ts\"\u003e\u0026#34;$(\u0026#34;\u003c/span\u003e)",
        "                        || (v.starts_with(\u003cspan class=\"ts\"\u003e\u0026#39;\u0026lt;\u0026#39;\u003c/span\u003e) \u0026amp;\u0026amp; v.trim_end_matches([\u003cspan class=\"ts\"\u003e\u0026#39;\u0026#34;\u0026#39;\u003c/span\u003e, \u003cspan class=\"ts\"\u003e\u0026#39;\\\u0026#39;\u0026#39;\u003c/span\u003e]).ends_with(\u003cspan class=\"ts\"\u003e\u0026#39;\u0026gt;\u0026#39;\u003c/span\u003e));",
        "                    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e placeholder {",
        "                        \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e whole.to_string();",
        "                    }",
        "                }",
        "                \u003cspan class=\"tk\"\u003ematch\u003c/span\u003e caps.get(rule.group) {",
        "                    \u003cspan class=\"tt\"\u003eSome\u003c/span\u003e(g) \u003cspan class=\"tk\"\u003eif\u003c/span\u003e rule.group \u0026gt; \u003cspan class=\"tn\"\u003e0\u003c/span\u003e =\u0026gt; {",
        "                        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e start = g.start() - caps.get(\u003cspan class=\"tn\"\u003e0\u003c/span\u003e).map_or(\u003cspan class=\"tn\"\u003e0\u003c/span\u003e, |m| m.start());",
        "                        \u003cspan class=\"tk\"\u003elet\u003c/span\u003e end = start + g.len();",
        "                        \u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(",
        "                            \u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e\u003cspan class=\"ts\"\u003e{}\u003c/span\u003e\u003cspan class=\"ts\"\u003e[REDACTED:\u003c/span\u003e\u003cspan class=\"ts\"\u003e{}\u003c/span\u003e\u003cspan class=\"ts\"\u003e]\u003c/span\u003e\u003cspan class=\"ts\"\u003e{}\u003c/span\u003e\u003cspan class=\"ts\"\u003e\u0026#34;\u003c/span\u003e,",
        "                            \u0026amp;whole[..start],",
        "                            rule.kind,",
        "                            \u0026amp;whole[end..]",
        "                        )",
        "                    }",
        "                    _ =\u0026gt; \u003cspan class=\"tf\"\u003eformat!\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;[REDACTED:\u003c/span\u003e\u003cspan class=\"ts\"\u003e{}\u003c/span\u003e\u003cspan class=\"ts\"\u003e]\u0026#34;\u003c/span\u003e, rule.kind),",
        "                }",
        "            })",
        "            .into_owned();",
        "        out = Cow::Owned(replaced);",
        "    }",
        "    out",
        "}"
      ]
