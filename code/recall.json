      "from": 120,
      "to": 163,
      "title": "Secret redaction before indexing",
      "why": "Every source's text passes through these rules before it is stored, so a pasted key never becomes searchable.",
      "calls": [
        "ingest",
        "note"
      ],
      "text": [
        "/// Replace likely secrets in `text` with `[REDACTED:\u003ckind\u003e]`.",
        "pub fn redact(text: \u0026str) -\u003e Cow\u003c'_, str\u003e {",
        "    let mut out: Cow\u003c'_, str\u003e = Cow::Borrowed(text);",
        "    for rule in rules() {",
        "        if !rule.re.is_match(\u0026out) {",
        "            continue;",
        "        }",
        "        let replaced = rule",
        "            .re",
        "            .replace_all(\u0026out, |caps: \u0026regex::Captures\u003c'_\u003e| {",
        "                let whole = caps.get(0).map_or(\"\", |m| m.as_str());",
        "                if !(rule.accept)(caps) {",
        "                    return whole.to_string();",
        "                }",
        "                if rule.group \u003e 0 {",
        "                    let v = caps.get(rule.group).map_or(\"\", |m| m.as_str());",
        "                    let v = v.trim_start_matches(['\"', '\\'']);",
        "                    let placeholder = v.starts_with(\"[REDACTED\")",
        "                        || v.starts_with(\"${\")",
        "                        || v.starts_with(\"$(\")",
        "                        || (v.starts_with('\u003c') \u0026\u0026 v.trim_end_matches(['\"', '\\'']).ends_with('\u003e'));",
        "                    if placeholder {",
        "                        return whole.to_string();",
        "                    }",
        "                }",
        "                match caps.get(rule.group) {",
        "                    Some(g) if rule.group \u003e 0 =\u003e {",
        "                        let start = g.start() - caps.get(0).map_or(0, |m| m.start());",
        "                        let end = start + g.len();",
        "                        format!(",
        "                            \"{}[REDACTED:{}]{}\",",
        "                            \u0026whole[..start],",
        "                            rule.kind,",
        "                            \u0026whole[end..]",
        "                        )",
        "                    }",
        "                    _ =\u003e format!(\"[REDACTED:{}]\", rule.kind),",
        "                }",
        "            })",
        "            .into_owned();",
        "        out = Cow::Owned(replaced);",
        "    }",
        "    out",
        "}"
      ],
      "lines": [
