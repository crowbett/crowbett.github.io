      "path": "internal/packsuggest/suggest.go",
      "from": 54,
      "to": 88,
      "title": "The suggestion pyramid",
      "why": "Packaging rules when the org has any, else the fit engine; then shape history, the fit engine on any package, the fallback tiers. The first answer wins.",
      "calls": [
        "pack"
      ],
      "text": [
        "func (s *PackagingSuggestionService) Suggest(ctx context.Context, orgID string, lines []SuggestionLine) (*models.PackagingSuggestion, error) {",
        "\tif s.ruleRepo == nil {",
        "\t\treturn nil, fmt.Errorf(\"packaging suggestion: rule repo not wired\")",
        "\t}",
        "\tunits, total := foldSuggestionLines(lines)",
        "\tif len(units) == 0 {",
        "\t\treturn nil, nil",
        "\t}",
        "",
        "\trules, err := s.ruleRepo.ListActive(ctx, orgID)",
        "\tif err != nil {",
        "\t\treturn nil, fmt.Errorf(\"packaging suggestion: load rules: %w\", err)",
        "\t}",
        "",
        "\tvar sug *models.PackagingSuggestion",
        "\tif len(rules) \u003e 0 {",
        "\t\tsug, err = s.matchWithRules(ctx, orgID, units, total, rules)",
        "\t} else {",
        "\t\tsug, err = s.fitSuggest(ctx, orgID, units)",
        "\t}",
        "\tif err != nil || sug != nil {",
        "\t\treturn sug, err",
        "\t}",
        "",
        "\tsug, err = s.shapeSuggest(ctx, orgID, units)",
        "\tif err != nil || sug != nil {",
        "\t\treturn sug, err",
        "\t}",
        "",
        "\tsug, err = s.fitOpenSuggest(ctx, orgID, units)",
        "\tif err != nil || sug != nil {",
        "\t\treturn sug, err",
        "\t}",
        "\treturn s.shapeFallback(ctx, orgID, units)",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (s *PackagingSuggestionService) \u003cspan class=\"tf\"\u003eSuggest\u003c/span\u003e(ctx context.Context, orgID \u003cspan class=\"tt\"\u003estring\u003c/span\u003e, lines []SuggestionLine) (*models.PackagingSuggestion, \u003cspan class=\"tt\"\u003eerror\u003c/span\u003e) {",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e s.ruleRepo == \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tk\"\u003enil\u003c/span\u003e, fmt.\u003cspan class=\"tf\"\u003eErrorf\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;packaging suggestion: rule repo not wired\u0026#34;\u003c/span\u003e)",
        "\t}",
        "\tunits, total := \u003cspan class=\"tf\"\u003efoldSuggestionLines\u003c/span\u003e(lines)",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(units) == \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tk\"\u003enil\u003c/span\u003e, \u003cspan class=\"tk\"\u003enil\u003c/span\u003e",
        "\t}",
        "",
        "\trules, err := s.ruleRepo.\u003cspan class=\"tf\"\u003eListActive\u003c/span\u003e(ctx, orgID)",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tk\"\u003enil\u003c/span\u003e, fmt.\u003cspan class=\"tf\"\u003eErrorf\u003c/span\u003e(\u003cspan class=\"ts\"\u003e\u0026#34;packaging suggestion: load rules: %w\u0026#34;\u003c/span\u003e, err)",
        "\t}",
        "",
        "\t\u003cspan class=\"tk\"\u003evar\u003c/span\u003e sug *models.PackagingSuggestion",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(rules) \u0026gt; \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\tsug, err = s.\u003cspan class=\"tf\"\u003ematchWithRules\u003c/span\u003e(ctx, orgID, units, total, rules)",
        "\t} \u003cspan class=\"tk\"\u003eelse\u003c/span\u003e {",
        "\t\tsug, err = s.\u003cspan class=\"tf\"\u003efitSuggest\u003c/span\u003e(ctx, orgID, units)",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e || sug != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e sug, err",
        "\t}",
        "",
        "\tsug, err = s.\u003cspan class=\"tf\"\u003eshapeSuggest\u003c/span\u003e(ctx, orgID, units)",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e || sug != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e sug, err",
        "\t}",
        "",
        "\tsug, err = s.\u003cspan class=\"tf\"\u003efitOpenSuggest\u003c/span\u003e(ctx, orgID, units)",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e err != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e || sug != \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e sug, err",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e s.\u003cspan class=\"tf\"\u003eshapeFallback\u003c/span\u003e(ctx, orgID, units)",
        "}"
      ]
    },
    {
      "path": "internal/packsuggest/shape_model.go",
      "from": 69,
      "to": 90,
      "title": "Learning from each shipment",
      "why": "Every shipment counts once per tier under its shape key; the modal package and its share become the model row shape history reads.",
      "calls": [
        "pack"
      ],
      "text": [
        "func (t *ShapeTally) Add(b ShapeBasket, n int) {",
        "\tfor _, tier := range ShapeTiers {",
        "\t\tif !b.FloorEligible \u0026\u0026 (tier == ShapeTierCountBand || tier == ShapeTierOrgMode) {",
        "\t\t\tcontinue",
        "\t\t}",
        "\t\tk := ShapeKey(tier, b.Lines)",
        "\t\tif k == \"\" {",
        "\t\t\tcontinue",
        "\t\t}",
        "\t\tid := shapeID{tier, k}",
        "\t\tif t.counts[id] == nil {",
        "\t\t\tt.counts[id] = map[string]int{}",
        "\t\t}",
        "\t\tt.counts[id][b.PackagingTypeID] += n",
        "\t\tif t.counts[id][b.PackagingTypeID] \u003c= 0 {",
        "\t\t\tdelete(t.counts[id], b.PackagingTypeID)",
        "\t\t\tif len(t.counts[id]) == 0 {",
        "\t\t\t\tdelete(t.counts, id)",
        "\t\t\t}",
        "\t\t}",
        "\t}",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e (t *ShapeTally) \u003cspan class=\"tf\"\u003eAdd\u003c/span\u003e(b ShapeBasket, n \u003cspan class=\"tt\"\u003eint\u003c/span\u003e) {",
        "\t\u003cspan class=\"tk\"\u003efor\u003c/span\u003e _, tier := \u003cspan class=\"tk\"\u003erange\u003c/span\u003e ShapeTiers {",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e !b.FloorEligible \u0026amp;\u0026amp; (tier == ShapeTierCountBand || tier == ShapeTierOrgMode) {",
        "\t\t\t\u003cspan class=\"tk\"\u003econtinue\u003c/span\u003e",
        "\t\t}",
        "\t\tk := \u003cspan class=\"tf\"\u003eShapeKey\u003c/span\u003e(tier, b.Lines)",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e k == \u003cspan class=\"ts\"\u003e\u0026#34;\u0026#34;\u003c/span\u003e {",
        "\t\t\t\u003cspan class=\"tk\"\u003econtinue\u003c/span\u003e",
        "\t\t}",
        "\t\tid := shapeID{tier, k}",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e t.counts[id] == \u003cspan class=\"tk\"\u003enil\u003c/span\u003e {",
        "\t\t\tt.counts[id] = \u003cspan class=\"tk\"\u003emap\u003c/span\u003e[\u003cspan class=\"tt\"\u003estring\u003c/span\u003e]\u003cspan class=\"tt\"\u003eint\u003c/span\u003e{}",
        "\t\t}",
        "\t\tt.counts[id][b.PackagingTypeID] += n",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e t.counts[id][b.PackagingTypeID] \u0026lt;= \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\t\t\u003cspan class=\"tt\"\u003edelete\u003c/span\u003e(t.counts[id], b.PackagingTypeID)",
        "\t\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(t.counts[id]) == \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\t\t\t\u003cspan class=\"tt\"\u003edelete\u003c/span\u003e(t.counts, id)",
        "\t\t\t}",
        "\t\t}",
        "\t}",
        "}"
      ]
    },
