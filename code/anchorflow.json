      "text": [
        "func CompareBinWalk(a, b string) int {",
        "\tif c := cmp.Compare(binWalkBucket(a), binWalkBucket(b)); c != 0 {",
        "\t\treturn c",
        "\t}",
        "\treturn cmp.Compare(a, b)",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e \u003cspan class=\"tf\"\u003eCompareBinWalk\u003c/span\u003e(a, b \u003cspan class=\"tt\"\u003estring\u003c/span\u003e) \u003cspan class=\"tt\"\u003eint\u003c/span\u003e {",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e c := cmp.\u003cspan class=\"tf\"\u003eCompare\u003c/span\u003e(\u003cspan class=\"tf\"\u003ebinWalkBucket\u003c/span\u003e(a), \u003cspan class=\"tf\"\u003ebinWalkBucket\u003c/span\u003e(b)); c != \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e c",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e cmp.\u003cspan class=\"tf\"\u003eCompare\u003c/span\u003e(a, b)",
        "}"
