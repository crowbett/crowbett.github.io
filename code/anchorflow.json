    {
      "path": "internal/packfit/fit.go",
      "from": 501,
      "to": 541,
      "title": "Flat-bag mailer model",
      "why": "A mailer is tried at each load thickness: girth shrinks the bag, fill and bulge cap the load, then the packer must place every item.",
      "calls": [
        "plan exclude="
      ],
      "text": [
        "// fitMailerBin finds the thinnest load the bag closes over. The load's",
        "// thickness is the sum of some layers' thicknesses, so the candidates are the",
        "// prefix sums of the items' thicknesses, thickest first; at each candidate t",
        "// the girth leaves the packer a bin of (along−t) × (across−t) × t and the fill",
        "// rule caps the load's volume at that thickness against the flat area inside",
        "// the margin. The bin it packed is returned so the visualizer draws the same",
        "// arrangement the engine accepted.",
        "func fitMailerBin(items []Item, p models.PackagingType) (uL, uW, uH float64, ok bool) {",
        "\tacross, along := fitMailerEnvelope(p)",
        "\tif across \u003c= 0 || along \u003c= 0 || len(items) == 0 {",
        "\t\treturn 0, 0, 0, false",
        "\t}",
        "\tm := fitMailerKinds[p.Kind]",
        "\tflat := (across/(1+m.Across) - m.Margin) * (along/(1+m.Along) - m.Margin)",
        "\tif flat \u003c= 0 {",
        "\t\treturn 0, 0, 0, false",
        "\t}",
        "\tvol, bulge := 0.0, 0.0",
        "\tfor _, it := range items {",
        "\t\tvol += volumeOf(it)",
        "\t\tif it.C \u003e= fitThickItemIn {",
        "\t\t\tbulge += it.C * it.C",
        "\t\t}",
        "\t}",
        "\tif m.Bulge \u003e 0 \u0026\u0026 bulge \u003e m.Bulge*flat+epEps {",
        "\t\treturn 0, 0, 0, false",
        "\t}",
        "\tfor _, t := range fitStackHeights(items, across) {",
        "\t\tuL, uW = along-t, across-t",
        "\t\tif uL \u003c= epEps || uW \u003c= epEps {",
        "\t\t\treturn 0, 0, 0, false",
        "\t\t}",
        "\t\tif m.Fill \u003e 0 \u0026\u0026 vol/t \u003e m.Fill*flat+epEps {",
        "\t\t\tcontinue",
        "\t\t}",
        "\t\tif fitPack(items, uL, uW, t, false) {",
        "\t\t\treturn uL, uW, t, true",
        "\t\t}",
        "\t}",
        "\treturn 0, 0, 0, false",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// fitMailerBin finds the thinnest load the bag closes over. The load\u0026#39;s\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// thickness is the sum of some layers\u0026#39; thicknesses, so the candidates are the\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// prefix sums of the items\u0026#39; thicknesses, thickest first; at each candidate t\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// the girth leaves the packer a bin of (along−t) × (across−t) × t and the fill\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// rule caps the load\u0026#39;s volume at that thickness against the flat area inside\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// the margin. The bin it packed is returned so the visualizer draws the same\u003c/span\u003e",
        "\u003cspan class=\"tc\"\u003e// arrangement the engine accepted.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003efunc\u003c/span\u003e \u003cspan class=\"tf\"\u003efitMailerBin\u003c/span\u003e(items []Item, p models.PackagingType) (uL, uW, uH \u003cspan class=\"tt\"\u003efloat64\u003c/span\u003e, ok \u003cspan class=\"tt\"\u003ebool\u003c/span\u003e) {",
        "\tacross, along := \u003cspan class=\"tf\"\u003efitMailerEnvelope\u003c/span\u003e(p)",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e across \u0026lt;= \u003cspan class=\"tn\"\u003e0\u003c/span\u003e || along \u0026lt;= \u003cspan class=\"tn\"\u003e0\u003c/span\u003e || \u003cspan class=\"tt\"\u003elen\u003c/span\u003e(items) == \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tk\"\u003efalse\u003c/span\u003e",
        "\t}",
        "\tm := fitMailerKinds[p.Kind]",
        "\tflat := (across/(\u003cspan class=\"tn\"\u003e1\u003c/span\u003e+m.Across) - m.Margin) * (along/(\u003cspan class=\"tn\"\u003e1\u003c/span\u003e+m.Along) - m.Margin)",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e flat \u0026lt;= \u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tk\"\u003efalse\u003c/span\u003e",
        "\t}",
        "\tvol, bulge := \u003cspan class=\"tn\"\u003e0.0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0.0\u003c/span\u003e",
        "\t\u003cspan class=\"tk\"\u003efor\u003c/span\u003e _, it := \u003cspan class=\"tk\"\u003erange\u003c/span\u003e items {",
        "\t\tvol += \u003cspan class=\"tf\"\u003evolumeOf\u003c/span\u003e(it)",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e it.C \u0026gt;= fitThickItemIn {",
        "\t\t\tbulge += it.C * it.C",
        "\t\t}",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e m.Bulge \u0026gt; \u003cspan class=\"tn\"\u003e0\u003c/span\u003e \u0026amp;\u0026amp; bulge \u0026gt; m.Bulge*flat+epEps {",
        "\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tk\"\u003efalse\u003c/span\u003e",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003efor\u003c/span\u003e _, t := \u003cspan class=\"tk\"\u003erange\u003c/span\u003e \u003cspan class=\"tf\"\u003efitStackHeights\u003c/span\u003e(items, across) {",
        "\t\tuL, uW = along-t, across-t",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e uL \u0026lt;= epEps || uW \u0026lt;= epEps {",
        "\t\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tk\"\u003efalse\u003c/span\u003e",
        "\t\t}",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e m.Fill \u0026gt; \u003cspan class=\"tn\"\u003e0\u003c/span\u003e \u0026amp;\u0026amp; vol/t \u0026gt; m.Fill*flat+epEps {",
        "\t\t\t\u003cspan class=\"tk\"\u003econtinue\u003c/span\u003e",
        "\t\t}",
        "\t\t\u003cspan class=\"tk\"\u003eif\u003c/span\u003e \u003cspan class=\"tf\"\u003efitPack\u003c/span\u003e(items, uL, uW, t, \u003cspan class=\"tk\"\u003efalse\u003c/span\u003e) {",
        "\t\t\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e uL, uW, t, \u003cspan class=\"tk\"\u003etrue\u003c/span\u003e",
        "\t\t}",
        "\t}",
        "\t\u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tk\"\u003efalse\u003c/span\u003e",
        "}"
      ]
    }
