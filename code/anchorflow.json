      "path": "internal/packfit/fit.go",
      "from": 259,
      "to": 284,
      "title": "Warehouse rules come first",
      "why": "Before any geometry, each package is barred or allowed by a named rule, so a big enough package can still be refused.",
      "calls": [
        "plan exclude="
      ],
      "text": [
        "// exclude names the rule that bars p from this basket, or \"\" when the engine",
        "// may use it.",
        "func (b basket) exclude(p models.PackagingType) string {",
        "\tif !p.IsActive || p.DeletedAt != nil {",
        "\t\treturn ExcludedInactive",
        "\t}",
        "\tif cls, ok := fitSpecialtyBox[p.Name]; ok \u0026\u0026 !b.present[cls] {",
        "\t\treturn ExcludedSpecialty",
        "\t}",
        "\t// Inner packaging is never the parcel. Left in the candidate pool a tube",
        "\t// lands in the mailer bucket and gets seam/flap/depth geometry that a",
        "\t// rigid tube does not have.",
        "\tif !p.IsParcel() {",
        "\t\treturn ExcludedInner",
        "\t}",
        "\tif p.Kind == \"box\" {",
        "\t\treturn \"\"",
        "\t}",
        "\tif b.needBox {",
        "\t\treturn ExcludedNeedsBox",
        "\t}",
        "\tif p.Kind == \"poly_mailer\" \u0026\u0026 !b.plainPolyOK {",
        "\t\treturn ExcludedPlainPoly",
        "\t}",
        "\treturn \"\"",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"tc\"\u003e// exclude names the rule that bars p from this basket, or \u0026#34;\u0026#34; when the engine\u003c/span\u003e",
