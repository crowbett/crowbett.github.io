      "from": 29,
      "to": 53,
      "title": "Reconcile a snapshot",
      "why": "Compares the server's state with the client's prediction for that tick and rolls back only when its own player differs.",
      "calls": [],
      "text": [
        "/// Applies `snap` to `p`: drops stale snapshots, acks pending inputs, compares the stored",
        "/// prediction for `snap.tick` and rolls back when needed.",
        "pub fn reconcile(p: \u0026mut Predictor, snap: \u0026Snapshot) -\u003e Outcome {",
        "    if snap.tick \u003c= p.confirmed().0 {",
        "        return Outcome::Stale;",
        "    }",
        "    p.set_confirmed(snap.tick, snap.hash);",
        "    p.ack_inputs(snap.ack_input_tick);",
        "    let me = p.me.index();",
        "    let held = p",
        "        .history()",
        "        .get(snap.tick)",
        "        .map(|h| h.players.get(me) == snap.players.get(me));",
        "    match held {",
        "        Some(true) =\u003e Outcome::Held,",
        "        Some(false) =\u003e Outcome::Rolled {",
        "            depth: full_rollback(p, snap),",
        "            mispredicted: true,",
        "        },",
        "        None =\u003e Outcome::Rolled {",
        "            depth: full_rollback(p, snap),",
        "            mispredicted: false,",
        "        },",
        "    }",
        "}"
      ],
      "lines": [
        "\u003cspan class=\"ts\"\u003e/// Applies `snap` to `p`: drops stale snapshots, acks pending inputs, compares the stored\u003c/span\u003e",
        "\u003cspan class=\"ts\"\u003e/// prediction for `snap.tick` and rolls back when needed.\u003c/span\u003e",
