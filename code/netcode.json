        "    p.set_confirmed(snap.tick, snap.hash);",
        "    p.ack_inputs(snap.ack_input_tick);",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e me = p.me.index();",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e held = p",
        "        .history()",
        "        .get(snap.tick)",
        "        .map(|h| h.players.get(me) == snap.players.get(me));",
        "    \u003cspan class=\"tk\"\u003ematch\u003c/span\u003e held {",
        "        \u003cspan class=\"tt\"\u003eSome\u003c/span\u003e(\u003cspan class=\"tk\"\u003etrue\u003c/span\u003e) =\u0026gt; Outcome::Held,",
        "        \u003cspan class=\"tt\"\u003eSome\u003c/span\u003e(\u003cspan class=\"tk\"\u003efalse\u003c/span\u003e) =\u0026gt; Outcome::Rolled {",
        "            depth: \u003cspan class=\"tt\"\u003efull_rollback\u003c/span\u003e(p, snap),",
        "            mispredicted: \u003cspan class=\"tt\"\u003etrue\u003c/span\u003e,",
        "        },",
        "        \u003cspan class=\"tt\"\u003eNone\u003c/span\u003e =\u0026gt; Outcome::Rolled {",
        "            depth: \u003cspan class=\"tt\"\u003efull_rollback\u003c/span\u003e(p, snap),",
        "            mispredicted: \u003cspan class=\"tt\"\u003efalse\u003c/span\u003e,",
        "        },",
        "    }",
