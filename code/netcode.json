      "title": "State hash",
      "why": "FNV-1a over the canonical bytes of the tick, every player field and the RNG: the hash clients and server compare.",
      "calls": [
        "new",
        "lag",
        "step"
      ],
      "text": [
        "    /// FNV-1a over the canonical little-endian bytes of tick, every player field and the rng.",
        "    pub fn hash(\u0026self) -\u003e u64 {",
        "        const FNV_OFFSET: u64 = 0xcbf2_9ce4_8422_2325;",
        "        const FNV_PRIME: u64 = 0x0100_0000_01b3;",
        "        let mut h = FNV_OFFSET;",
        "        let mut mix = |bytes: \u0026[u8]| {",
        "            for b in bytes {",
        "                h ^= u64::from(*b);",
        "                h = h.wrapping_mul(FNV_PRIME);",
        "            }",
        "        };",
        "        mix(\u0026self.tick.0.to_le_bytes());",
        "        for p in \u0026self.players {",
        "            mix(\u0026[p.id.0, u8::from(p.active), p.dash_cd]);",
        "            mix(\u0026p.pos.x.0.to_le_bytes());",
        "            mix(\u0026p.pos.y.0.to_le_bytes());",
        "            mix(\u0026p.vel.x.0.to_le_bytes());",
        "            mix(\u0026p.vel.y.0.to_le_bytes());",
        "        }",
        "        mix(\u0026self.rng.state().to_le_bytes());",
        "        h",
        "    }"
      ],
      "lines": [
        "\u003cspan class=\"ts\"\u003e/// FNV-1a over the canonical little-endian bytes of tick, every player field and the rng.\u003c/span\u003e",
        "\u003cspan class=\"tk\"\u003epub\u003c/span\u003e \u003cspan class=\"tk\"\u003efn\u003c/span\u003e \u003cspan class=\"tf\"\u003ehash\u003c/span\u003e(\u0026amp;self) -\u0026gt; \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e {",
        "    \u003cspan class=\"tk\"\u003econst\u003c/span\u003e FNV_OFFSET: \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e = \u003cspan class=\"tn\"\u003e0xcbf2_9ce4_8422_2325\u003c/span\u003e;",
        "    \u003cspan class=\"tk\"\u003econst\u003c/span\u003e FNV_PRIME: \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e = \u003cspan class=\"tn\"\u003e0x0100_0000_01b3\u003c/span\u003e;",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e h = FNV_OFFSET;",
        "    \u003cspan class=\"tk\"\u003elet\u003c/span\u003e \u003cspan class=\"tk\"\u003emut\u003c/span\u003e mix = |bytes: \u003cspan class=\"tk\"\u003e\u0026amp;\u003c/span\u003e[\u003cspan class=\"tt\"\u003eu8\u003c/span\u003e]| {",
        "        \u003cspan class=\"tk\"\u003efor\u003c/span\u003e b \u003cspan class=\"tk\"\u003ein\u003c/span\u003e bytes {",
        "            h ^= \u003cspan class=\"tt\"\u003eu64\u003c/span\u003e::from(*b);",
        "            h = h.wrapping_mul(FNV_PRIME);",
        "        }",
        "    };",
        "    mix(\u0026amp;self.tick.\u003cspan class=\"tn\"\u003e0.\u003c/span\u003eto_le_bytes());",
        "    \u003cspan class=\"tk\"\u003efor\u003c/span\u003e p \u003cspan class=\"tk\"\u003ein\u003c/span\u003e \u0026amp;self.players {",
        "        mix(\u0026amp;[p.id.\u003cspan class=\"tn\"\u003e0\u003c/span\u003e, \u003cspan class=\"tt\"\u003eu8\u003c/span\u003e::from(p.active), p.dash_cd]);",
        "        mix(\u0026amp;p.pos.x.\u003cspan class=\"tn\"\u003e0.\u003c/span\u003eto_le_bytes());",
        "        mix(\u0026amp;p.pos.y.\u003cspan class=\"tn\"\u003e0.\u003c/span\u003eto_le_bytes());",
        "        mix(\u0026amp;p.vel.x.\u003cspan class=\"tn\"\u003e0.\u003c/span\u003eto_le_bytes());",
        "        mix(\u0026amp;p.vel.y.\u003cspan class=\"tn\"\u003e0.\u003c/span\u003eto_le_bytes());",
        "    }",
        "    mix(\u0026amp;self.rng.state().to_le_bytes());",
        "    h",
        "}"
      ]
    }
