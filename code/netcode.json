        "    \u003cspan class=\"tk\"\u003eif\u003c/span\u003e snap.tick \u0026lt;= p.confirmed().\u003cspan class=\"tn\"\u003e0\u003c/span\u003e {",
        "        \u003cspan class=\"tk\"\u003ereturn\u003c/span\u003e Outcome::Stale;",
